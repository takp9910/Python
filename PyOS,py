def open_terminal(desktop, *_) -> None:
    w = AppWindow(desktop, "Терминал", "🖥", mem=14)
    kernel = desktop.os
    bar = tk.Frame(w.body, bg="#0b1220")
    bar.pack(side="bottom", fill="x", pady=(6, 0))
    prompt_lbl = tk.Label(bar, bg="#0b1220", fg="#7dd3fc", font=("Consolas", 11))
    prompt_lbl.pack(side="left")
    entry = tk.Entry(bar, bg="#0b1220", fg="#7dd3fc", insertbackground="#7dd3fc",
                     font=("Consolas", 11), bd=0)
    entry.pack(side="left", fill="x", expand=True, padx=(6, 0))
    sb = tk.Scrollbar(w.body)
    sb.pack(side="right", fill="y")
    out = tk.Text(w.body, bg="#0b1220", fg="#7dd3fc", font=("Consolas", 11),
                  bd=0, wrap="word", state="disabled", padx=8, pady=6,
                  yscrollcommand=sb.set)
    out.pack(fill="both", expand=True)
    sb.config(command=out.yview)

    def write(s: str) -> None:
        try:
            out.config(state="normal")
            if "\033[2J" in s:
                out.delete("1.0", "end")
                s = s.replace("\033[2J", "").replace("\033[H", "")
            out.insert("end", s)
            out.config(state="disabled")
            out.see("end")
        except tk.TclError:
            pass

    def refresh_prompt():
        prompt_lbl.config(text=f"{kernel.users.prompt()} {kernel.vfs.path_str()}>")

    def submit(event=None) -> None:
        line = entry.get()
        entry.delete(0, "end")
        write(f"{kernel.users.prompt()} {kernel.vfs.path_str()}> {line}\n")
        alive = kernel.shell.execute(line, out=write)
        if w._closed:
            return
        if not alive:
            w.close()
            return
        refresh_prompt()

    def hist_up(event):
        h = kernel.shell.history
        if h:
            entry.delete(0, "end")
            entry.insert(0, h[-1])
        return "break"

    def autocomplete(event):
        text = entry.get()
        if " " in text:
            return
        cmds = [m[4:] for m in dir(kernel.shell) if m.startswith("cmd_")]
        matches = [c for c in cmds if c.startswith(text)]
        if len(matches) == 1:
            entry.delete(0, "end")
            entry.insert(0, matches[0] + " ")
        elif matches:
            write("  ".join(matches) + "\n")
        return "break"

    entry.bind("<Return>", submit)
    entry.bind("<Up>", hist_up)
    entry.bind("<Tab>", autocomplete)
    kernel.shell.execute("banner", out=write)
    refresh_prompt()
    w.after(120, entry.focus_set)


def open_calc(desktop, *_) -> None:
    w = AppWindow(desktop, "Калькулятор", "🧮", mem=8)
    box = centered(w.body)
    disp = tk.Entry(box, font=("Segoe UI", 24), bd=0, bg="#0b1220", fg="white",
                    justify="right", insertbackground="white", width=14)
    disp.grid(row=0, column=0, columnspan=4, sticky="nsew", ipady=14, pady=(0, 8))
    err = [False]

    def set_text(text: str, is_error: bool = False) -> None:
        disp.delete(0, "end")
        disp.insert(0, text)
        err[0] = is_error

    def press(ch: str) -> None:
        if err[0]:
            set_text("")
        if ch == "=":
            expr = disp.get()
            if not expr.strip():
                return
            try:
                set_text(fmt_num(safe_eval(expr)))
            except ZeroDivisionError:
                set_text("Деление на 0", True)
            except Exception:
                set_text("Ошибка", True)
        elif ch == "C":
            set_text("")
        elif ch == "⌫":
            s = disp.get()
            if s:
                disp.delete(len(s) - 1, "end")
        else:
            disp.insert("end", ch)

    keys = [["C", "(", ")", "/"], ["7", "8", "9", "*"], ["4", "5", "6", "-"],
            ["1", "2", "3", "+"], ["0", ".", "⌫", "="]]
    for r, row in enumerate(keys, start=1):
        for c, k in enumerate(row):
            tk.Button(box, text=k, width=5, height=1, font=("Segoe UI", 16, "bold"),
                      command=lambda k=k: press(k)
                      ).grid(row=r, column=c, sticky="nsew", padx=3, pady=3)
    disp.bind("<Return>", lambda e: press("="))
    w.after(120, disp.focus_set)


def open_notes(desktop, *_) -> None:
    w = AppWindow(desktop, "Заметки", "🗒", mem=10)
    kernel = desktop.os
    lb = tk.Listbox(w.body, font=("Consolas", 11), bd=0)
    lb.pack(fill="both", expand=True)

    def notes_path():
        return f"/home/{kernel.users.current}/notes_db.json"

    def load():
        try:
            return json.loads(kernel.vfs.read(notes_path()))
        except Exception:
            return []

    def save(db):
        try:
            kernel.vfs.write(notes_path(), json.dumps(db, ensure_ascii=False, indent=2))
        except (VFSError, PermError) as e:
            messagebox.showerror("Заметки", str(e), parent=w)

    def refresh():
        lb.delete(0, "end")
        for n in load():
            lb.insert("end", f"[{n.get('t','?')}] {n.get('text','')}")

    def add():
        txt = simpledialog.askstring("Заметка", "Текст:", parent=w)
        if txt:
            db = load()
            db.append({"t": now_iso(), "text": txt})
            save(db)
            refresh()

    def delete():
        sel = lb.curselection()
        if not sel:
            return
        db = load()
        db.pop(sel[0])
        save(db)
        refresh()

    bar = tk.Frame(w.body, bg=BG_WINDOW)
    bar.pack(fill="x", pady=(8, 0))
    tk.Button(bar, text="➕ Добавить", command=add).pack(side="left")
    tk.Button(bar, text="🗑 Удалить", command=delete).pack(side="left", padx=6)
    refresh()


