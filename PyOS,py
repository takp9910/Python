        search_var = tk.StringVar(value=query)
        self.start_search_var = search_var
        search = tk.Entry(inner, textvariable=search_var, font=FONT, bd=0,
                          bg="#1e2126", fg="white", insertbackground="white")
        search.pack(fill="x", padx=24, pady=(18, 12), ipady=6)
        tk.Label(inner, text="  Приложения", bg=MENU_BG, fg="#cdd3da",
                 font=FONT_BOLD, anchor="w").pack(fill="x", padx=12)
        grid = tk.Frame(inner, bg=MENU_BG)
        grid.pack(fill="both", expand=True, padx=16, pady=8)
        bottom = tk.Frame(inner, bg=MENU_BG)
        bottom.pack(side="bottom", fill="x", padx=20, pady=12)
        tk.Label(bottom, text=f"👤  {self.os.users.whoami()}",
                 bg=MENU_BG, fg="#dfe4ea", font=FONT_BOLD).pack(side="left")
        tk.Button(bottom, text="⏻", bg=MENU_BG, fg="#dfe4ea", bd=0, font=FONT_BOLD,
                  activebackground="#ef4444", activeforeground="white",
                  command=self.shutdown).pack(side="right")

        state = {"cells": [], "empty": None}
        quick = tk.Frame(inner, bg=MENU_BG)
        quick.pack(fill="x", padx=16, pady=(0, 4))
        tk.Label(quick, text="Быстрый доступ", bg=MENU_BG, fg="#9fb3c8",
                 font=FONT_BOLD).pack(side="left")
        for key in ("computer", "device_manager", "settings"):
            title, icon, opener = APPS[key]
            tk.Button(quick, text=f"{icon} {title}", command=lambda o=opener: (self.close_start_menu(), o(self)),
                      bg=MENU_BG, fg="#dfe4ea", bd=0, activebackground=MENU_HOVER).pack(side="left", padx=4)

        def rebuild(*_):
            q = search_var.get().strip().lower()
            if not state["cells"]:
                col = row = 0
                for key, (title, icon, opener) in APPS.items():
                    def launch(o=opener):
                        self.close_start_menu()
                        self.root.after(10, lambda: o(self))

                    cell = tk.Button(
                        grid, text=f"{icon}\n{title}", command=launch,
                        bg=MENU_BG, fg="#dfe4ea", activebackground=MENU_HOVER,
                        activeforeground="white", bd=0, relief="flat",
                        highlightthickness=0, cursor="hand2", width=12, height=4,
                        font=FONT, wraplength=120, justify="center")
                    cell.grid(row=row, column=col, padx=4, pady=4,
                              sticky="nsew")
                    cell.bind("<Enter>",
                              lambda e, btn=cell: self._paint_menu((btn,), MENU_HOVER))
                    cell.bind("<Leave>",
                              lambda e, btn=cell: self._paint_menu((btn,), MENU_BG))
                    state["cells"].append((f"{key} {title}".lower(), cell))
                    col += 1
                    if col >= 4:
                        col = 0
                        row += 1
            found = 0
            for title_l, cell in state["cells"]:
                if q and q not in title_l:
                    cell.grid_remove()
                else:
                    cell.grid()
                    found += 1
            if state["empty"] is None:
                state["empty"] = tk.Label(grid, text="Ничего не найдено",
                                           bg=MENU_BG, fg="#9fb3c8", font=FONT)
            if q and not found:
                state["empty"].grid(row=0, column=0, columnspan=4, pady=20)
            else:
                state["empty"].grid_remove()

        search_var.trace_add("write", rebuild)
        rebuild()
        m.bind("<FocusOut>",
               lambda e: self.root.after(120, self._close_menu_if_unfocused))
        m.bind("<Escape>", lambda e: self.close_start_menu())
        self.start_menu = m
        search.focus_set()

    @staticmethod
    def _paint_menu(widgets, color: str) -> None:
        for wd in widgets:
            try:
                wd.config(bg=color)
            except tk.TclError:
                pass

    def _close_menu_if_unfocused(self) -> None:
        m = self.start_menu
        if m is None:
            return
        try:
            f = self.root.focus_get()
            inside = f is not None and f.winfo_toplevel() is m
        except (KeyError, tk.TclError):
            inside = False
        if not inside:
            self.close_start_menu()

    def notify(self, title: str, text: str) -> None:
        toast = tk.Toplevel(self.root)
        toast.overrideredirect(True)
        toast.attributes("-topmost", True)
        toast.configure(bg="#2b2f36")
        tw, th = 340, 84
        x = self.root.winfo_rootx() + self.root.winfo_width() - tw - 16
        y = self.root.winfo_rooty() + 16 + len(self._toasts) * (th + 10)
        toast.geometry(f"{tw}x{th}+{x}+{y}")
        tk.Label(toast, text=title, bg="#2b2f36", fg="#7dd3fc",
                 font=FONT_BOLD, anchor="w").pack(fill="x", padx=12, pady=(10, 0))
        tk.Label(toast, text=text, bg="#2b2f36", fg="#e0e6ed", font=FONT,
                 anchor="w", wraplength=tw - 24, justify="left"
                 ).pack(fill="both", expand=True, padx=12, pady=(2, 8))
        toast.bind("<Button-1>", lambda e: self._dismiss(toast))
        self._toasts.append(toast)
        toast.after(4500, lambda: self._dismiss(toast))

    def _dismiss(self, toast) -> None:
        if toast in self._toasts:
            self._toasts.remove(toast)
        try:
            toast.destroy()
        except tk.TclError:
            pass

    def shutdown(self) -> None:
        self.close_start_menu()
        if messagebox.askyesno(VERSION, "Выключить PyOS?", parent=self.root):
            self.os.shutdown()
            self.root.destroy()

    def tick(self) -> None:
        try:
            self.clock.config(
                text=datetime.datetime.now().strftime("%H:%M:%S   %d.%m.%Y"))
            self.root.after(1000, self.tick)
        except tk.TclError:
            pass


