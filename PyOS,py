class Kernel:
    """Ядро PyOS: собирает подсистемы, хранит состояние."""

    STATE_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), ".pyos3_state.json")
    LEGACY_STATE_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), ".pyos_state.json")

    def __init__(self) -> None:
        self.bus = EventBus()
        self.vfs = VFS()
        self.logger = Logger(self.vfs)
        self.users = UserManager(self.logger)
        self.procs = ProcessManager(self.bus, self.logger)
        self.net = NetManager()
        self.scheduler = Scheduler(self)
        self.packages = PackageManager(self)
        self.shell = Shell(self)
        # связываем VFS с правами и текущим пользователем
        self.vfs.set_perm_checker(self.users.check_perm)
        self.vfs.set_current_user_provider(lambda: self.users.current)
        self.theme = "dark"
        self.wallpaper = "nebula"
        self.icon_positions: dict[str, list[int]] = {}
        self.icon_size = 96
        self.icon_scale = 1.0
        self.autosave_enabled = True
        self.show_tooltips = True
        self.sound_enabled = True
        self.sound_volume = 0.7
        self.aliases: dict[str, str] = {}
        self.env_vars: dict[str, str] = {}
        self.started = time.time()
        self._stop = False
        self.launcher: Optional[Callable[..., bool]] = None
        self.desktop_notify: Optional[Callable[[str, str], None]] = None
        self.achievements = AchievementManager(self)
        self._load_state()
        # Состояние VFS не должно оставлять гостя в домашнем каталоге другого пользователя.
        self.vfs.cd(self.users.users[self.users.current].home)
        self.scheduler.start()
        self.bus.on("on_boot", lambda **_: self.logger.info("boot complete"))

    # ---------- состояние ----------
    def _load_state(self) -> None:
        try:
            with open(self.STATE_FILE, encoding="utf-8") as f:
                state = json.load(f)
            if state.get("state_version") == STATE_VERSION:
                self.vfs.import_state(state.get("vfs", {}))
                self.theme = state.get("theme", self.theme)
                self.wallpaper = state.get("wallpaper", self.wallpaper)
                self.icon_positions = state.get("icon_positions", {}) or {}
                self.icon_size = max(64, min(144, int(state.get("icon_size", self.icon_size))))
                self.icon_scale = max(0.75, min(1.5, float(state.get("icon_scale", self.icon_scale))))
                self.autosave_enabled = bool(state.get("autosave_enabled", self.autosave_enabled))
                self.show_tooltips = bool(state.get("show_tooltips", self.show_tooltips))
                self.sound_enabled = bool(state.get("sound_enabled", self.sound_enabled))
                self.sound_volume = max(0.0, min(1.0, float(state.get("sound_volume", self.sound_volume))))
                self.aliases = state.get("aliases", {}) or {}
                self.packages.installed = set(state.get("packages", []))
                self.packages.repo_url = str(state.get("package_repo", ""))
                catalog = state.get("package_catalog", {})
                if isinstance(catalog, dict):
                    self.packages.remote_registry = catalog
                self.packages.import_extensions(state.get("package_extensions", {}))
                self.env_vars = state.get("env_vars", {}) or {}
                self.achievements.load(state.get("achievements", {}))
                return
        except (OSError, ValueError):
            pass
        try:
            with open(self.LEGACY_STATE_FILE, encoding="utf-8") as f:
                legacy = json.load(f)
            self.vfs.import_state(legacy.get("vfs", {}))
            if legacy.get("theme") in ("default", "cyber", "retro", "matrix"):
                self.theme = legacy["theme"]
            if isinstance(legacy.get("wallpaper"), str):
                self.wallpaper = legacy["wallpaper"]
            self.icon_positions = legacy.get("icon_positions", {}) or {}
            self.icon_size = max(64, min(144, int(legacy.get("icon_size", self.icon_size))))
            self.icon_scale = max(0.75, min(1.5, float(legacy.get("icon_scale", self.icon_scale))))
            self.autosave_enabled = bool(legacy.get("autosave_enabled", self.autosave_enabled))
            self.show_tooltips = bool(legacy.get("show_tooltips", self.show_tooltips))
            self.logger.info("состояние мигрировано из PyOS 2.2")
        except (OSError, ValueError):
            pass

    def save_state(self) -> None:
        state = {
            "state_version": STATE_VERSION,
            "vfs": self.vfs.export_state(),
            "theme": self.theme,
            "wallpaper": self.wallpaper,
            "icon_positions": self.icon_positions,
            "icon_size": self.icon_size,
            "icon_scale": self.icon_scale,
            "autosave_enabled": self.autosave_enabled,
            "show_tooltips": self.show_tooltips,
            "sound_enabled": self.sound_enabled,
            "sound_volume": self.sound_volume,
            "aliases": self.aliases,
            "packages": sorted(self.packages.installed),
            "package_repo": self.packages.repo_url,
            "package_catalog": self.packages.remote_registry,
            "package_extensions": self.packages.export_extensions(),
            "env_vars": self.env_vars,
            "achievements": self.achievements.unlocked,
        }
        directory = os.path.dirname(self.STATE_FILE) or "."
        try:
            fd, tmp = tempfile.mkstemp(prefix=".pyos3.", dir=directory, text=True)
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                json.dump(state, f, ensure_ascii=False, indent=2)
                f.flush()
                os.fsync(f.fileno())
            os.replace(tmp, self.STATE_FILE)
        except (OSError, ValueError):
            pass

    def export_snapshot(self, host_path: str) -> None:
        snap = {
            "state_version": STATE_VERSION,
            "vfs": self.vfs.export_state(),
            "users": {n: {"role": u.role, "groups": u.groups}
                      for n, u in self.users.users.items()},
            "packages": sorted(self.packages.installed),
            "theme": self.theme, "wallpaper": self.wallpaper,
        }
        with open(host_path, "w", encoding="utf-8") as f:
            json.dump(snap, f, ensure_ascii=False, indent=2)

    def import_snapshot(self, host_path: str) -> None:
        with open(host_path, encoding="utf-8") as f:
            snap = json.load(f)
        self.vfs.import_state(snap.get("vfs", {}))
        self.packages.installed = set(snap.get("packages", []))
        self.theme = snap.get("theme", self.theme)
        self.wallpaper = snap.get("wallpaper", self.wallpaper)

    def start_autosave(self) -> None:
        def loop() -> None:
            while not self._stop:
                time.sleep(60)
                if self._stop:
                    break
                if not self.autosave_enabled:
                    continue
                try:
                    self.save_state()
                except Exception as e:
                    self.logger.error(f"autosave: {e}")
        t = threading.Thread(target=loop, daemon=True)
        t.start()

    def shutdown(self) -> None:
        self._stop = True
        self.scheduler.stop()
        self.save_state()
        self.bus.emit("on_shutdown")
        self.logger.info("shutdown")


# ============================================================
#                    ОБОЛОЧКА (CLI)
# ============================================================
class Shell:
    """Диспетчер команд: работает и в CLI, и в GUI через callback вывода."""

    ANSI_RED = "\033[31m"
    ANSI_GREEN = "\033[32m"
    ANSI_YELLOW = "\033[33m"
    ANSI_BLUE = "\033[34m"
    ANSI_RESET = "\033[0m"

    def __init__(self, kernel: Kernel) -> None:
        self.k = kernel
        self.history: list[str] = []
        self._local = threading.local()
        self._exit_flag = False

    # ---------- вывод ----------
    @property
    def _out(self) -> Optional[Callable[[str], None]]:
        return getattr(self._local, "out", None)

    @_out.setter
    def _out(self, value: Optional[Callable[[str], None]]) -> None:
        self._local.out = value

    def _print(self, s: str = "") -> None:
        s = str(s)
        out = self._out
        if out is not None:
            try:
                out(s + "\n")
            except Exception:
                pass
        else:
            print(s)

    def _color(self, text: str, code: str) -> str:
        return f"{code}{text}{self.ANSI_RESET}" if self._out is None else text

    def err(self, msg: str) -> None:
        self._print(self._color("✕ " + msg, self.ANSI_RED))

    def ok(self, msg: str) -> None:
        self._print(self._color("✓ " + msg, self.ANSI_GREEN))

    def warn(self, msg: str) -> None:
        self._print(self._color("⚠ " + msg, self.ANSI_YELLOW))

    def info(self, msg: str) -> None:
        self._print(self._color(msg, self.ANSI_BLUE))

    # ---------- выполнение ----------
    def execute(self, line: str, out: Optional[Callable[[str], None]] = None) -> bool:
        old = self._out
        self._out = out
        self._exit_flag = False
        line = line.rstrip()
        if line.strip():
            self.history.append(line)
            self._save_history(line)
        try:
            self._dispatch(line)
        except (KeyboardInterrupt, EOFError):
            self._print("\nпрервано")
        except (PyOSError, VFSError, PermError) as e:
            self.err(str(e))
        except Exception as e:
            self.logger_err("shell", e)
            self.err(f"внутренняя ошибка: {e}")
        finally:
            self._out = old
        return not self._exit_flag

    def execute_silent(self, line: str) -> None:
        """Выполняет без вывода (для scheduler). Потокобезопасно (thread-local)."""
        old = self._out
        self._out = lambda s: None
        try:
            self._dispatch(line)
        except Exception as e:
            self.k.logger.error(f"silent: {e}")
        finally:
            self._out = old

    def logger_err(self, ctx: str, e: Exception) -> None:
        self.k.logger.error(f"{ctx}: {e}\n{traceback.format_exc()}")

    def _history_file(self) -> str:
        return f"/home/{self.k.users.current}/.bash_history"

    def _save_history(self, line: str) -> None:
        try:
            path = self._history_file()
            cur = self.k.vfs.read(path) if self.k.vfs.exists(path) else ""
            self.k.vfs.write(path, cur + line + "\n", system=True)
        except Exception:
            pass

    def _load_history(self) -> None:
        try:
            path = self._history_file()
            if self.k.vfs.exists(path):
                self.history = self.k.vfs.read(path).splitlines()
            else:
                self.history = []
        except Exception:
            self.history = []

    def _ask_password(self, prompt: str) -> str:
        """Запрашивает пароль: через simpledialog в GUI, через input в CLI."""
        if self._out is not None and tk is not None:
            try:
                return simpledialog.askstring("Пароль", prompt, show="•") or ""
            except Exception:
                pass
        return self._ask(prompt)

    def _ask(self, prompt: str) -> str:
        try:
            return input(prompt)
        except (EOFError, KeyboardInterrupt):
            return ""

    # ---------- диспетчер ----------
    def _dispatch(self, line: str) -> None:
        line = line.strip()
        if not line:
            return
        first = line.split()[0]
        if first in self.k.aliases:
            line = self.k.aliases[first] + line[len(first):]
        if line == "!!":
            if len(self.history) < 2:
                self.err("нет предыдущей команды")
                return
            line = self.history[-2]
            self._print(line)
        elif line.startswith("!") and line[1:].isdigit():
            idx = int(line[1:])
            if 1 <= idx <= len(self.history):
                line = self.history[idx - 1]
                self._print(line)
            else:
                self.err("нет команды с таким номером")
                return
        if "&&" in line:
            for part in line.split("&&"):
                self._dispatch(part.strip())
            return
        if "|" in line and not line.startswith("|"):
            self._run_pipe(line)
            return
        if line.startswith("sudo "):
            self._handle_sudo(line[5:].strip())
            return
        try:
            parts = shlex.split(line)
        except ValueError as e:
            self.err(f"ошибка разбора: {e}")
            return
        if not parts:
            return
        cmd, args = parts[0], parts[1:]
        handler = getattr(self, f"cmd_{cmd}", None) if cmd.isidentifier() else None
        if handler is None:
            package_command = self.k.packages.commands.get(cmd)
            if package_command:
                output = package_command.get("output", "")
                output = output.replace("{args}", " ".join(args))
                self._print(output)
                return
            self.err(f"{cmd}: команда не найдена. Введите help.")
            return
        handler(args)

    def _run_pipe(self, line: str) -> None:
        parts = [p.strip() for p in line.split("|")]
        buf: list[str] = []
        old = self._out

        def capture(s: str) -> None:
            buf.append(s)

        self._out = capture
        try:
            for part in parts[:-1]:
                self._dispatch(part)
        finally:
            self._out = old
        last = parts[-1]
        tokens = last.split()
        if not tokens:
            return
        cmd = tokens[0]
        if cmd == "grep" and len(tokens) >= 2:
            pat = tokens[1].strip("'\"")
            for l in buf:
                if pat in l:
                    self._print(l.rstrip("\n"))
        elif cmd in ("head", "tail"):
            n = 10
            for a in tokens[1:]:
                if a.startswith("-") and a[1:].isdigit():
                    n = int(a[1:])
            seq = buf[:n] if cmd == "head" else buf[-n:]
            for l in seq:
                self._print(l.rstrip("\n"))
        elif cmd == "wc":
            lines = len(buf)
            words = sum(len(l.split()) for l in buf)
            chars = sum(len(l) for l in buf)
            self._print(f"{lines:>6} {words:>6} {chars:>6}")
        elif cmd == "sort":
            for l in sorted(buf):
                self._print(l.rstrip("\n"))
        elif cmd == "uniq":
            prev = object()
            for l in buf:
                if l != prev:
                    self._print(l.rstrip("\n"))
                prev = l
        elif cmd == "cat":
            for l in buf:
                self._print(l.rstrip("\n"))
        else:
            # неизвестная команда справа — просто печатаем содержимое
            for l in buf:
                self._print(l.rstrip("\n"))

    def _handle_sudo(self, inner: str) -> None:
        if self.k.users.is_admin():
            self._dispatch(inner)
            return
        pwd = self._ask_password("Пароль sudo: ")
        root_hash = self.k.users.users["root"].password_hash
        if root_hash is None or self.k.users._h(pwd) != root_hash:
            self.err("неверный пароль sudo")
            return
        old = self.k.users.current
        self.k.users.current = "root"
        try:
            self._dispatch(inner)
        finally:
            self.k.users.current = old

    # ========================================================
    #                    КОМАНДЫ
    # ========================================================
    def cmd_help(self, args) -> None:
        groups = {
            "Файлы": "ls cd pwd mkdir touch cat rm tree cp mv find grep chmod chown ln trash head tail wc sort uniq diff",
            "Сеть": "ping fetch net curl wget",
            "Пакеты": "pkg",
            "Планировщик": "schedule at bg jobs fg killjob",
            "Процессы": "ps top kill pstree nice renice",
            "Пользователи": "login logout su sudo passwd groups groupadd usermod",
            "Система": "sysinfo date whoami uptime free df du mount umount history alias unalias env export system logs fsck selftest",
            "Приложения": "edit calc notes theme files monitor settings market guess tictactoe hangman",
            "Развлечения": "fortune figlet lolcat sl cowsay matrix",
            "Прочее": "man which time yes seq basename dirname echo clear notify banner exit",
        }
        for g, cmds in groups.items():
            self.info(f"\n── {g} ──")
            for c in cmds.split():
                self._print(f"  {c}")

    def cmd_man(self, args) -> None:
        if not args:
            self.err("использование: man <команда>")
            return
        cmd = args[0]
        handler = getattr(self, f"cmd_{cmd}", None)
        if handler is None:
            self.err(f"нет команды {cmd}")
            return
        doc = (handler.__doc__ or "нет описания").strip()
        self.info(f"man {cmd}")
        self._print(doc)

    def cmd_which(self, args) -> None:
        for c in args:
            h = getattr(self, f"cmd_{c}", None)
            self._print(f"/usr/bin/{c}" if h else f"{c}: not found")

    def cmd_time(self, args) -> None:
        if not args:
            self.err("использование: time <команда>")
            return
        t0 = time.perf_counter()
        self._dispatch(" ".join(args))
        dt = time.perf_counter() - t0
        self.info(f"real\t{dt:.3f}s")

    def cmd_banner(self, args) -> None:
        self._print(r"""
  ____        ___  ____
 |  _ \ _   _/ _ \/ ___|
 | |_) | | | | | | \___ \
 |  __/| |_| | |_| |___) |
 |_|    \__, |\___/|____/
        |___/    Nebula 3.0
""")

    def cmd_sysinfo(self, args) -> None:
        up = str(datetime.timedelta(seconds=int(time.time() - self.k.started)))
        self._print(VERSION)
        self._print(f"Python:       {sys.version.split()[0]}")
        self._print(f"Платформа:    {sys.platform}")
        self._print(f"Пользователь: {self.k.users.whoami()} ({self.k.users.role()})")
        self._print(f"Аптайм:       {up}")
        self._print(f"Процессов:    {len(self.k.procs.procs)}")
        self._print(f"Память:       {self.k.procs.total_mem()} MB")
        df = self.k.vfs.df()
        self._print(f"Файлов:       {df['files']}  ({human_size(df['bytes'])})")
        self._print(f"Тема:         {self.k.theme}")

    def cmd_date(self, args) -> None:
        self._print(datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S"))

    def cmd_whoami(self, args) -> None:
        self._print(self.k.users.whoami())

    def cmd_uptime(self, args) -> None:
        up = time.time() - self.k.started
        h = int(up // 3600)
        m = int((up % 3600) // 60)
        self._print(f"up {h}:{m:02d},  users: 1,  load: {random.uniform(0,1):.2f}")

    def cmd_echo(self, args) -> None:
        self._print(" ".join(args))

    def cmd_clear(self, args) -> None:
        self._print("\033[2J\033[H")

    def cmd_exit(self, args) -> None:
        self._print("Завершение сеанса PyOS...")
        self._exit_flag = True

    def cmd_yes(self, args) -> None:
        txt = " ".join(args) or "y"
        for _ in range(50):
            self._print(txt)

    def cmd_seq(self, args) -> None:
        try:
            if len(args) == 1:
                a, b = 1, int(args[0])
            elif len(args) == 2:
                a, b = int(args[0]), int(args[1])
            else:
                raise ValueError
        except ValueError:
            self.err("использование: seq [start] end")
            return
        for i in range(a, b + 1):
            self._print(str(i))

    def cmd_basename(self, args) -> None:
        for a in args:
            self._print(a.rstrip("/").rsplit("/", 1)[-1])

    def cmd_dirname(self, args) -> None:
        for a in args:
            if "/" in a:
                self._print(a.rsplit("/", 1)[0] or "/")
            else:
                self._print(".")

    def cmd_notify(self, args) -> None:
        text = " ".join(args).strip()
        if not text:
            self.err("использование: notify <текст>")
            return
        if self.k.desktop_notify:
            self.k.desktop_notify("Терминал", text)
        else:
            self._print(text)

    # ---------- файлы ----------
    def cmd_pwd(self, args) -> None:
        self._print(self.k.vfs.path_str())

    def cmd_ls(self, args) -> None:
        long = False
        hidden = False
        for a in args:
            if a.startswith("-") and len(a) > 1:
                for ch in a[1:]:
                    if ch == "l":
                        long = True
                    elif ch == "a":
                        hidden = True
        paths = [a for a in args if not a.startswith("-")] or [None]
        for p in paths:
            parts = self.k.vfs.resolve(p)
            node = self.k.vfs._get(parts)
            if node is None:
                self.err(f"нет такого пути: {p}")
                continue
            if len(paths) > 1:
                self._print(f"{p or '.'}:")
            if node.kind != "dir":
                items = [(parts[-1] if parts else "/", node)]
            else:
                items = [(n, c) for n, c in sorted(node.children.items())
                         if hidden or not c.hidden]
            if not items:
                self._print("(пусто)")
                continue
            for name, n in items:
                suffix = "/" if n.kind == "dir" else ("@" if n.kind == "link" else "")
                if long:
                    kind = "d" if n.kind == "dir" else ("l" if n.kind == "link" else "-")
                    ts = datetime.datetime.fromtimestamp(n.mtime).strftime("%d.%m %H:%M")
                    self._print(
                        f"{kind}{mode_str(n.mode)} {n.owner:<6} {n.group:<6} "
                        f"{human_size(len(n.content)):>6} {ts}  {name}{suffix}")
                else:
                    self._print(name + suffix)

    def cmd_cd(self, args) -> None:
        if args:
            self.k.vfs.cd(args[0])
        else:
            self.k.vfs.cd(self.k.users.users[self.k.users.current].home)

    def cmd_mkdir(self, args) -> None:
        if not args:
            self.err("укажите имя")
            return
        success = False
        for a in args:
            try:
                self.k.vfs.mkdir(a)
                success = True
            except (VFSError, PermError) as e:
                self.err(f"{a}: {e}")
        if success:
            self.ok("готово")

    def cmd_touch(self, args) -> None:
        if not args:
            self.err("укажите имя")
            return
        for a in args:
            try:
                self.k.vfs.touch(a)
            except (VFSError, PermError) as e:
                self.err(f"{a}: {e}")

    def cmd_cat(self, args) -> None:
        if not args:
            self.err("укажите файл")
            return
        for a in args:
            try:
                self._print(self.k.vfs.read(a).rstrip("\n"))
            except (VFSError, PermError) as e:
                self.err(f"{a}: {e}")

    def cmd_rm(self, args) -> None:
        recursive = any(a in ("-r", "-R", "-rf", "-fr") for a in args)
        paths = [a for a in args if not a.startswith("-")]
        if not paths:
            self.err("укажите путь")
            return
        for p in paths:
            try:
                self.k.vfs.rm(p, recursive=recursive)
            except (VFSError, PermError) as e:
                self.err(f"{p}: {e}")
        self.ok("операция завершена")

    def cmd_tree(self, args) -> None:
        try:
            for line in self.k.vfs.tree_lines(args[0] if args else "/"):
                self._print(line)
        except VFSError as e:
            self.err(str(e))

    def cmd_cp(self, args) -> None:
        if len(args) != 2:
            self.err("использование: cp <src> <dst>")
            return
        try:
            data = self.k.vfs.read(args[0])
            self.k.vfs.write(args[1], data)
            self.ok("скопировано")
        except (VFSError, PermError) as e:
            self.err(str(e))

    def cmd_mv(self, args) -> None:
        if len(args) != 2:
            self.err("использование: mv <src> <dst>")
            return
        try:
            data = self.k.vfs.read(args[0])
            self.k.vfs.write(args[1], data)
            self.k.vfs.rm(args[0], trash=False)
            self.ok("перемещено")
        except (VFSError, PermError) as e:
            self.err(str(e))

    def cmd_find(self, args) -> None:
        base = "/"
        pattern = "*"
        rest = list(args)
        if rest and rest[0] != "-name":
            base = rest.pop(0)
        if "-name" in rest:
            i = rest.index("-name")
