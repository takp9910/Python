            self.err("нужен root или владелец")
            return
        try:
            node.mode = parse_mode(args[0])
            self.ok(f"права: {mode_str(node.mode)}")
        except ValueError as e:
            self.err(str(e))

    def cmd_chown(self, args) -> None:
