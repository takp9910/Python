class AppWindow(tk.Toplevel if tk else object):
    """Окно приложения с кастомной рамкой, snap-зонами."""

    def __init__(self, desktop, title: str, icon: str = "📄", mem: int = 12) -> None:
        super().__init__(desktop.root)
        self.desktop = desktop
        self.kernel = desktop.os
        self._closed = False
        self._maximized = False
        self._normal_geom: Optional[str] = None
        self.btn_max = None
        self._off = (0, 0)
        self._snapped: Optional[str] = None
        self._presnap_size: Optional[tuple] = None

        self.title(title)
        self.configure(bg=BG_WINDOW)
        self.minsize(360, 260)
        if not NATIVE:
            self.overrideredirect(True)
        self.protocol("WM_DELETE_WINDOW", self.close)

        self.pid = self.kernel.procs.spawn(title, mem, self.kernel.users.current)

        if not NATIVE:
            self.titlebar = tk.Frame(self, bg=ACCENT, height=32)
            self.titlebar.pack(fill="x")
            self.titlebar.pack_propagate(False)
            self.title_lbl = tk.Label(self.titlebar, text=f"{icon}  {title}",
                                      bg=ACCENT, fg="white", font=FONT_BOLD)
            self.title_lbl.pack(side="left", padx=8)
            tk.Button(self.titlebar, text="✕", bg=ACCENT, fg="white", bd=0,
                      activebackground="#ef4444", font=FONT_BOLD,
                      command=self.close).pack(side="right", padx=2)
            self.btn_max = tk.Button(self.titlebar, text="❐", bg=ACCENT, fg="white",
                                     bd=0, activebackground=ACCENT_DARK,
                                     font=FONT_BOLD, command=self.toggle_maximize)
            self.btn_max.pack(side="right", padx=2)
            tk.Button(self.titlebar, text="—", bg=ACCENT, fg="white", bd=0,
                      activebackground=ACCENT_DARK, font=FONT_BOLD,
                      command=self.minimize).pack(side="right", padx=2)
            for w in (self.titlebar, self.title_lbl):
                w.bind("<Button-1>", self._drag_start)
                w.bind("<B1-Motion>", self._drag_move)
                w.bind("<Double-Button-1>", lambda e: self.toggle_maximize())

        self.body = tk.Frame(self, bg=BG_WINDOW)
        self.body.pack(fill="both", expand=True, padx=8, pady=8)
        if not NATIVE:
            self.resize_grip = tk.Frame(self, bg=ACCENT, cursor="bottom_right_corner",
                                        width=12, height=12)
            self.resize_grip.place(relx=1.0, rely=1.0, anchor="se")
            self.resize_grip.bind("<Button-1>", self._resize_start)
            self.resize_grip.bind("<B1-Motion>", self._resize_move)

        self._place_default()
        desktop.register_window(self)
        self.after(80, self._take_focus)

    def _take_focus(self) -> None:
        try:
            self.lift()
            self.focus_force()
        except tk.TclError:
            pass

    def open_maximized(self) -> None:
        root = self.desktop.root
        root.update_idletasks()
        w = root.winfo_width()
        h = root.winfo_height() - TASKBAR_H - (40 if NATIVE else 0)
        self.geometry(f"{w}x{h}+{root.winfo_rootx()}+{root.winfo_rooty()}")
        self._maximized = True
        if self.btn_max:
            self.btn_max.config(text="❐")

    def _place_default(self) -> None:
        root = self.desktop.root
        root.update_idletasks()
        sw = root.winfo_width()
        sh = root.winfo_height() - TASKBAR_H - (40 if NATIVE else 0)
        w = min(820, max(360, sw - 120))
        h = min(560, max(260, sh - 100))
        n = len(self.desktop.windows)
        x = root.winfo_rootx() + 60 + (n * 32) % max(40, sw - w - 100)
        y = root.winfo_rooty() + 40 + (n * 32) % max(40, sh - h - 100)
        self.geometry(f"{w}x{h}+{x}+{y}")
        self._maximized = False
        if self.btn_max:
            self.btn_max.config(text="⛶")

    def toggle_maximize(self) -> None:
        if self._maximized:
            self.geometry(self._normal_geom or "640x420+120+80")
            self._maximized = False
            if self.btn_max:
                self.btn_max.config(text="⛶")
        else:
            self._normal_geom = self.geometry()
            self.open_maximized()

    def _drag_start(self, e) -> None:
        self._off = (e.x_root - self.winfo_x(), e.y_root - self.winfo_y())
        if self._snapped:
            self._unsnap(e)

    def _drag_move(self, e) -> None:
        if self._maximized:
            return
        root = self.desktop.root
        rx = root.winfo_rootx()
        ry = root.winfo_rooty()
        rw = root.winfo_width()
        at_left = e.x_root <= rx + 8
        at_right = e.x_root >= rx + rw - 8
        at_top = e.y_root <= ry + 4
        if at_left or at_right:
            self._snap("left" if at_left else "right")
            return
        if at_top:
            self.open_maximized()
            return
        if self._snapped:
            return
        self.geometry(f"+{e.x_root - self._off[0]}+{e.y_root - self._off[1]}")

    def _resize_start(self, e) -> None:
        self._resize_origin = (e.x_root, e.y_root, self.winfo_width(), self.winfo_height())

    def _resize_move(self, e) -> None:
        if self._maximized or not hasattr(self, "_resize_origin"):
            return
        sx, sy, sw, sh = self._resize_origin
        self.geometry(f"{max(360, sw + e.x_root - sx)}x{max(260, sh + e.y_root - sy)}")

    def _snap(self, side: str) -> None:
        if self._snapped == side:
            return
        if not self._snapped:
            self._presnap_size = (self.winfo_width(), self.winfo_height())
        root = self.desktop.root
        root.update_idletasks()
        w = root.winfo_width() // 2
        h = root.winfo_height() - TASKBAR_H - (40 if NATIVE else 0)
        x = root.winfo_rootx() + (0 if side == "left" else root.winfo_width() - w)
        self.geometry(f"{w}x{h}+{x}+{root.winfo_rooty()}")
        self._snapped = side

    def _unsnap(self, e) -> None:
        w, h = self._presnap_size or (760, 540)
        self._snapped = None
        self._off = (max(30, w // 3), 20)
        self.geometry(f"{w}x{h}+{e.x_root - self._off[0]}+{e.y_root - self._off[1]}")

    def minimize(self) -> None:
        self.withdraw()

    def close(self) -> None:
        if self._closed:
            return
        self._closed = True
        self.desktop.unregister_window(self)
        try:
            self.kernel.procs.kill(self.pid)
        except Exception:
            pass
        try:
            self.destroy()
        except tk.TclError:
            pass


