class Process:
    def __init__(self, pid: int, name: str, mem: int, user: str,
                 parent: int = 0, nice: int = 0) -> None:
        self.pid = pid
        self.name = name
        self.mem = mem
        self.user = user
        self.parent = parent
        self.nice = nice
        self.state = "running"
        self.cpu = random.uniform(0, 3)
        self.started = time.time()
        self.open_files: list[str] = []


class ProcessManager:
    """Процессы с приоритетами, состояниями, сигналами, деревом."""

    def __init__(self, bus: EventBus, logger: Logger) -> None:
        self.bus = bus
        self.logger = logger
        self.procs: list[Process] = [
            Process(1, "init", 4, "root", parent=0),
            Process(42, "pyos-gui", 88, "root", parent=1),
            Process(100, "shell", 12, "user", parent=1),
        ]
        self._next = 200
        self.on_kill: Optional[Callable[[int], None]] = None

    def spawn(self, name: str, mem: int = 10, user: str = "user",
              parent: int = 1, nice: int = 0) -> int:
        p = Process(self._next, name, mem, user, parent, nice)
        self._next += 1
        self.procs.append(p)
        self.bus.emit("on_proc_spawn", pid=p.pid, name=name)
        return p.pid

    def find(self, pid: int) -> Optional[Process]:
        for p in self.procs:
            if p.pid == pid:
                return p
        return None

    def kill(self, pid: int, sig: str = "TERM"):
        p = self.find(pid)
        if p is None:
            return False, f"нет процесса с pid={pid}"
        if pid == 1:
            return False, "нельзя убить init"
        if sig == "STOP":
            p.state = "sleeping"
            return True, f"процесс {pid} остановлен"
        if sig == "CONT":
            p.state = "running"
            return True, f"процесс {pid} продолжен"
        self.procs.remove(p)
        self.bus.emit("on_proc_kill", pid=pid)
        if self.on_kill:
            try:
                self.on_kill(pid)
            except Exception:
                self.on_kill = None
        return True, f"процесс {pid} завершён ({sig})"

    def renice(self, pid: int, nice: int) -> None:
        p = self.find(pid)
        if p is None:
            raise PyOSError("нет такого процесса")
        p.nice = max(-20, min(19, nice))

    def pstree(self) -> list[str]:
        by_parent: dict[int, list[Process]] = {}
        for p in self.procs:
            by_parent.setdefault(p.parent, []).append(p)
        lines = []

        def rec(pid: int, prefix: str) -> None:
            p = self.find(pid)
            if p is None:
                return
            lines.append(prefix + f"{p.name}({p.pid})")
            kids = by_parent.get(pid, [])
            for i, k in enumerate(kids):
                last = i == len(kids) - 1
                rec(k.pid, prefix + ("└─ " if last else "├─ "))

        rec(1, "")
        return lines

    def total_mem(self) -> int:
        return sum(p.mem for p in self.procs)


