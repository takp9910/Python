class DesktopIcon:
    """Ярлык на Canvas с drag-n-drop."""

    def __init__(self, canvas, title, icon, callback, x, y, moved=None,
                 size=96, scale=1.0) -> None:
        self.callback = callback
        self.canvas = canvas
        self._moved = moved
        self._drag = None
        self._icon_width = max(64, int(size * scale))
        self._icon_height = self._icon_width
        self.frame = tk.Frame(canvas, bg=ICON_BG, width=self._icon_width,
                              height=self._icon_height, cursor="hand2")
        self.frame.pack_propagate(False)
        self.lbl_icon = tk.Label(self.frame, text=icon, bg=ICON_BG, fg="white",
                                 font=("Segoe UI", 26))
        self.lbl_icon.pack(pady=(8, 0))
        self.lbl_name = tk.Label(self.frame, text=title, bg=ICON_BG, fg="white",
                                 font=FONT, wraplength=88)
        self.lbl_name.pack(pady=(2, 0))
        self.widgets = (self.frame, self.lbl_icon, self.lbl_name)
        for w in self.widgets:
            w.bind("<Double-Button-1>", lambda e: self.callback())
            w.bind("<Button-1>", self._drag_start)
            w.bind("<B1-Motion>", self._drag_move)
            w.bind("<ButtonRelease-1>", self._drag_end)
            w.bind("<Enter>", lambda e: self._paint(ICON_HOVER))
            w.bind("<Leave>", self._hover_off)
        self.item = canvas.create_window(x, y, window=self.frame, anchor="nw")

    def _clamp(self, x, y):
        W, H = self.canvas.winfo_width(), self.canvas.winfo_height()
        grid = max(16, self._icon_width + 14)
        usable_h = max(0, H - TASKBAR_H)
        x = round(max(0, min(x, max(0, W - self._icon_width))) / grid) * grid
        y = round(max(0, min(y, max(0, usable_h - self._icon_height))) / grid) * grid
        return (max(0, min(x, max(0, W - self._icon_width))),
                max(0, min(y, max(0, usable_h - self._icon_height))))

    def _drag_start(self, e) -> None:
        x, y = self.canvas.coords(self.item)
        self._drag = (e.x_root, e.y_root, x, y)

    def _drag_move(self, e) -> None:
        if not self._drag:
            return
        sx, sy, x, y = self._drag
        x, y = self._clamp(x + e.x_root - sx, y + e.y_root - sy)
        self.canvas.coords(self.item, x, y)

    def _drag_end(self, e) -> None:
        if self._drag:
            _, _, x, y = self._drag
            x, y = self._clamp(x + e.x_root - self._drag[0],
                               y + e.y_root - self._drag[1])
            self.canvas.coords(self.item, x, y)
            if self._moved:
                self._moved(x, y)
        self._drag = None

    def _paint(self, color: str) -> None:
        for w in self.widgets:
            w.config(bg=color)

    def _hover_off(self, event=None) -> None:
        try:
            px, py = self.frame.winfo_pointerxy()
            under = self.frame.winfo_containing(px, py)
        except (tk.TclError, KeyError):
            under = None
        if under not in self.widgets:
            self._paint(ICON_BG)


