    def cmd_export(self, args) -> None:
        """Экспорт файла VFS на хост ИЛИ установка переменной окружения (NAME=value)."""
        if not args:
            self.err("export <vpath> <hostpath>  |  export NAME=value")
            return
        if len(args) == 2 and "=" not in args[0]:
            vpath, host = args
            try:
                with open(host, "w", encoding="utf-8") as f:
                    f.write(self.k.vfs.read(vpath))
                self.ok(f"экспортировано в {host}")
            except (OSError, VFSError, PermError) as e:
                self.err(str(e))
        else:
            for a in args:
                if "=" in a:
                    name, val = a.split("=", 1)
                    self.k.env_vars[name] = val
                    self.ok(f"{name}={val}")
                else:
                    self.err(f"неверный формат: {a}")

