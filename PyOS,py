    w = AppWindow(desktop, "Медиаплеер", "🎵", mem=8)
    canvas = tk.Canvas(w.body, bg="#0b1220", highlightthickness=0)
    canvas.pack(fill="both", expand=True)
    tracks = ["track1.mp3", "track2.mp3", "track3.mp3"]
    cur = [0]
    info = tk.Label(w.body, text="", bg="#0b1220", fg="#7dd3fc", font=FONT)
    info.pack(fill="x")

    def draw_bars():
        if w._closed:
            return
        try:
            canvas.delete("all")
            W = canvas.winfo_width() or 500
            H = canvas.winfo_height() or 250
            for i in range(40):
                x = W * i / 40
                h = random.randint(10, H - 20)
                canvas.create_rectangle(x, H - h, x + W / 60, H,
                                        fill="#22c55e", outline="")
            info.config(text=f"Играет: {tracks[cur[0]]}")
        except tk.TclError:
            return
        w.after(300, draw_bars)

