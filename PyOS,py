    box = centered(w.body)
    state = {"board": [" "] * 9}
    LINES = [(0, 1, 2), (3, 4, 5), (6, 7, 8), (0, 3, 6),
             (1, 4, 7), (2, 5, 8), (0, 4, 8), (2, 4, 6)]
    status = tk.Label(box, text="Ваш ход", bg=BG_WINDOW, fg=ACCENT,
                      font=("Segoe UI", 14, "bold"))
    status.pack(pady=(0, 10))
    grid = tk.Frame(box, bg=BG_WINDOW)
    grid.pack()
    btns = []

    def winner(b):
        for a, c, d in LINES:
            if b[a] != " " and b[a] == b[c] == b[d]:
                return b[a]
        return None

    def update():
        b = state["board"]
        for i, btn in enumerate(btns):
            btn.config(text=b[i],
                       state="disabled" if b[i] != " " or winner(b) else "normal")
        wn = winner(b)
        if wn == "X":
            status.config(text="🎉 Победа!", fg="#22c55e")
        elif wn == "O":
            status.config(text="Компьютер победил", fg="#ef4444")
        elif " " not in b:
            status.config(text="Ничья", fg="#888")

    def click(i):
        b = state["board"]
        if b[i] != " " or winner(b):
            return
        b[i] = "X"
        if " " in b and not winner(b):
            free = [j for j, v in enumerate(b) if v == " "]
            b[random.choice(free)] = "O"
        update()

    def new_game():
        state["board"] = [" "] * 9
        update()

