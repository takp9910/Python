def open_2048(desktop, *_) -> None:
    w = AppWindow(desktop, "2048", "🔢", mem=8)
    desktop.os.achievements.unlock("welcome")
    box = centered(w.body)
    grid = tk.Frame(box, bg=BG_WINDOW)
    grid.pack()
    state = {"board": [[0] * 4 for _ in range(4)], "score": 0}
    labels = [[None] * 4 for _ in range(4)]
    score_lbl = tk.Label(box, text="Счёт: 0", bg=BG_WINDOW,
                         font=("Segoe UI", 14, "bold"))
    score_lbl.pack(pady=6)

    COLORS = {0: "#ccc", 2: "#eee4da", 4: "#ede0c8", 8: "#f2b179",
              16: "#f59563", 32: "#f67c5f", 64: "#f65e3b",
              128: "#edcf72", 256: "#edcc61", 512: "#edc850",
              1024: "#edc53f", 2048: "#edc22e"}

    def new_tile():
        empties = [(i, j) for i in range(4) for j in range(4)
                   if state["board"][i][j] == 0]
        if empties:
            i, j = random.choice(empties)
            state["board"][i][j] = random.choice([2, 2, 4])

    def draw():
        for i in range(4):
            for j in range(4):
                v = state["board"][i][j]
                if v >= 128:
                    desktop.os.achievements.unlock("2048_128")
                if v >= 2048:
                    desktop.os.achievements.unlock("2048_2048")
                labels[i][j].config(text=str(v) if v else "",
                                    bg=COLORS.get(v, "#3c3a32"),
                                    fg="#776e65" if v < 8 else "white")
        score_lbl.config(text=f"Счёт: {state['score']}")

    def compress(row):
        nz = [x for x in row if x]
        out = []
        i = 0
        while i < len(nz):
            if i + 1 < len(nz) and nz[i] == nz[i + 1]:
                out.append(nz[i] * 2)
                state["score"] += nz[i] * 2
                i += 2
            else:
                out.append(nz[i])
                i += 1
        return out + [0] * (4 - len(out))

    def move(direction):
        b = state["board"]
        before = [row[:] for row in b]
        if direction in ("left", "right"):
            for i in range(4):
                row = b[i] if direction == "left" else b[i][::-1]
                row = compress(row)
                b[i] = row if direction == "left" else row[::-1]
        else:
            for j in range(4):
                col = [b[i][j] for i in range(4)]
                if direction == "down":
                    col = col[::-1]
                col = compress(col)
                if direction == "down":
                    col = col[::-1]
                for i in range(4):
                    b[i][j] = col[i]
        if b == before:
            return
        new_tile()
        draw()

    def key(event):
        m = {"Up": "up", "Down": "down", "Left": "left", "Right": "right"}
        if event.keysym in m:
            move(m[event.keysym])

    for i in range(4):
        for j in range(4):
            lbl = tk.Label(grid, text="", width=4, height=2,
                           font=("Segoe UI", 20, "bold"), bg="#ccc")
            lbl.grid(row=i, column=j, padx=2, pady=2)
            labels[i][j] = lbl
    new_tile()
    new_tile()
    draw()
    w.bind("<Key>", key)
    w.after(120, lambda: w.focus_force())


def open_snake(desktop, *_) -> None:
    w = AppWindow(desktop, "Змейка", "🐍", mem=7)
    desktop.os.achievements.unlock("welcome")
    canvas = tk.Canvas(w.body, bg="#0b1220", highlightthickness=0)
    canvas.pack(fill="both", expand=True)
    state = {"snake": [(10, 10)], "dir": (1, 0), "food": (15, 15),
             "alive": True, "score": 0}
    CELL = 18

    def draw():
        canvas.delete("all")
        for (x, y) in state["snake"]:
            canvas.create_rectangle(x * CELL, y * CELL,
                                    (x + 1) * CELL, (y + 1) * CELL,
                                    fill="#22c55e", outline="")
        fx, fy = state["food"]
        canvas.create_rectangle(fx * CELL, fy * CELL,
                                (fx + 1) * CELL, (fy + 1) * CELL,
                                fill="#ef4444", outline="")
        canvas.create_text(10, 10, anchor="nw", fill="#7dd3fc",
                           text=f"Счёт: {state['score']}",
                           font=("Consolas", 12))

    def tick():
        if not state["alive"] or w._closed:
            return
        try:
            dx, dy = state["dir"]
            x, y = state["snake"][-1]
            nx, ny = x + dx, y + dy
            cols = max(2, canvas.winfo_width() // CELL)
            rows = max(2, canvas.winfo_height() // CELL)
            if (nx, ny) in state["snake"] or nx < 0 or ny < 0 or nx >= cols or ny >= rows:
                state["alive"] = False
                draw()
                canvas.create_text(canvas.winfo_width() / 2,
                                   canvas.winfo_height() / 2,
                                   text="Игра окончена", fill="#ef4444",
                                   font=("Segoe UI", 24, "bold"))
                return
            state["snake"].append((nx, ny))
            if (nx, ny) == state["food"]:
                state["score"] += 1
                if state["score"] >= 10:
                    desktop.os.achievements.unlock("snake_10")
                if state["score"] >= 50:
                    desktop.os.achievements.unlock("snake_50")
                free = [(fx, fy) for fx in range(cols) for fy in range(rows)
                        if (fx, fy) not in state["snake"]]
                if free:
                    state["food"] = random.choice(free)
            else:
                state["snake"].pop(0)
            draw()
        except tk.TclError:
            return
        w.after(150, tick)

    def key(event):
        m = {"Up": (0, -1), "Down": (0, 1), "Left": (-1, 0), "Right": (1, 0)}
        if event.keysym in m:
            new_dir = m[event.keysym]
            old_dir = state["dir"]
            if len(state["snake"]) == 1 or new_dir != (-old_dir[0], -old_dir[1]):
                state["dir"] = new_dir

    w.bind("<Key>", key)
    w.after(120, lambda: (w.focus_force(), tick()))


def open_tetris(desktop, *_) -> None:
    w = AppWindow(desktop, "Тетрис", "🧱", mem=8)
    desktop.os.achievements.unlock("welcome")
    canvas = tk.Canvas(w.body, bg="#0b1220", highlightthickness=0)
    canvas.pack(fill="both", expand=True)
    CELL = 22
    COLS, ROWS = 10, 18
    SHAPES = [
        ["....", "XXXX", "....", "...."],
        ["X..", "XXX", "..."],
        ["XX.", ".XX", "..."],
        ["XXX", "X..", "X.."],
        ["XX", "XX"],
        ["XXX", "X.X"],
        ["X..", "XXX", "..."],
    ]
    state = {"board": [[0] * COLS for _ in range(ROWS)], "score": 0,
             "over": False, "cur": None, "x": 3, "y": 0}

    def collision(shape, px, py):
        for i, row in enumerate(shape):
            for j, ch in enumerate(row):
                if ch != "X":
                    continue
                x, y = px + j, py + i
                if x < 0 or x >= COLS or y >= ROWS:
                    return True
                if y >= 0 and state["board"][y][x]:
                    return True
        return False

    def new_piece():
        shape = random.choice(SHAPES)
        state["cur"] = shape
        state["x"] = COLS // 2 - len(shape[0]) // 2
        state["y"] = 0
        if collision(shape, state["x"], state["y"]):
            state["over"] = True

    def rotate(shape):
        height, width = len(shape), max(len(row) for row in shape)
        padded = [row.ljust(width, ".") for row in shape]
        return ["".join(padded[height - 1 - r][c] for r in range(height))
                for c in range(width)]

    def lock():
        shape = state["cur"]
        for i, row in enumerate(shape):
            for j, ch in enumerate(row):
                if ch == "X":
                    x, y = state["x"] + j, state["y"] + i
                    if 0 <= y < ROWS:
                        state["board"][y][x] = 1
        for i in range(ROWS - 1, -1, -1):
            if all(state["board"][i]):
                del state["board"][i]
                state["board"].insert(0, [0] * COLS)
                state["score"] += 10
                desktop.os.achievements.unlock("tetris_line")
                if state["score"] >= 100:
                    desktop.os.achievements.unlock("tetris_100")
        new_piece()

    def draw():
        canvas.delete("all")
        for i in range(ROWS):
            for j in range(COLS):
                if state["board"][i][j]:
                    canvas.create_rectangle(j * CELL, i * CELL,
                                            (j + 1) * CELL, (i + 1) * CELL,
                                            fill="#3b82f6", outline="")
        if state["cur"]:
            for i, row in enumerate(state["cur"]):
                for j, ch in enumerate(row):
                    if ch == "X":
                        x, y = state["x"] + j, state["y"] + i
                        canvas.create_rectangle(x * CELL, y * CELL,
                                                (x + 1) * CELL, (y + 1) * CELL,
                                                fill="#f59e0b", outline="")
        canvas.create_text(10, 10, anchor="nw", fill="#7dd3fc",
                           text=f"Счёт: {state['score']}",
                           font=("Consolas", 12))
        if state["over"]:
            canvas.create_text(canvas.winfo_width() / 2,
                               canvas.winfo_height() / 2,
                               text="Игра окончена", fill="#ef4444",
                               font=("Segoe UI", 24, "bold"))

    def tick():
        if state["over"] or w._closed:
            return
        try:
            if not collision(state["cur"], state["x"], state["y"] + 1):
                state["y"] += 1
            else:
                lock()
            draw()
        except tk.TclError:
            return
        w.after(500, tick)

    def key(event):
        if state["over"] or not state["cur"]:
            return
        if event.keysym == "Left" and not collision(state["cur"], state["x"] - 1, state["y"]):
            state["x"] -= 1
        elif event.keysym == "Right" and not collision(state["cur"], state["x"] + 1, state["y"]):
            state["x"] += 1
        elif event.keysym == "Down" and not collision(state["cur"], state["x"], state["y"] + 1):
            state["y"] += 1
        elif event.keysym == "space":
            while not collision(state["cur"], state["x"], state["y"] + 1):
                state["y"] += 1
        elif event.keysym == "Up":
            turned = rotate(state["cur"])
            if not collision(turned, state["x"], state["y"]):
                state["cur"] = turned
        draw()

    new_piece()
    w.bind("<Key>", key)
    w.after(120, lambda: (w.focus_force(), tick()))


def open_minesweeper(desktop, *_) -> None:
    w = AppWindow(desktop, "Сапёр", "💣", mem=7)
    desktop.os.achievements.unlock("welcome")
    size = 9
    bombs = 10
    box = centered(w.body)
    grid = tk.Frame(box, bg=BG_WINDOW)
    grid.pack()
    board = [[0] * size for _ in range(size)]
    revealed = [[False] * size for _ in range(size)]
    flags = [[False] * size for _ in range(size)]
    btns = [[None] * size for _ in range(size)]
    finished = [False]
    for i, j in random.sample([(i, j) for i in range(size) for j in range(size)], bombs):
        board[i][j] = -1
    for i in range(size):
        for j in range(size):
            if board[i][j] == -1:
                continue
            cnt = sum(1 for di in (-1, 0, 1) for dj in (-1, 0, 1)
                      if 0 <= i + di < size and 0 <= j + dj < size
                      and board[i + di][j + dj] == -1)
            board[i][j] = cnt

    def reveal(i, j):
        if finished[0] or revealed[i][j] or flags[i][j]:
            return
        revealed[i][j] = True
        btns[i][j].config(state="disabled", relief="sunken")
        if board[i][j] == -1:
            finished[0] = True
            desktop.os.achievements.unlock("minesweeper_boom")
            btns[i][j].config(text="💣", bg="#ef4444")
            for bi in range(size):
                for bj in range(size):
                    if board[bi][bj] == -1:
                        btns[bi][bj].config(text="💣", bg="#ef4444")
            return
        if board[i][j] == 0:
            for di in (-1, 0, 1):
                for dj in (-1, 0, 1):
                    if 0 <= i + di < size and 0 <= j + dj < size:
                        reveal(i + di, j + dj)
        else:
            btns[i][j].config(text=str(board[i][j]))
        if sum(revealed[ri][rj] for ri in range(size) for rj in range(size)) == size * size - bombs:
            finished[0] = True
            desktop.os.achievements.unlock("minesweeper_win")
            messagebox.showinfo("Сапёр", "Победа!", parent=w)

    def flag(event, i, j):
        if revealed[i][j]:
            return
        flags[i][j] = not flags[i][j]
        btns[i][j].config(text="🚩" if flags[i][j] else "")

    for i in range(size):
        for j in range(size):
            btn = tk.Button(grid, width=2, font=("Segoe UI", 12, "bold"))
            btn.grid(row=i, column=j)
            btn.bind("<Button-1>", lambda e, i=i, j=j: reveal(i, j))
            btn.bind("<Button-3>", lambda e, i=i, j=j: flag(e, i, j))
            btns[i][j] = btn


