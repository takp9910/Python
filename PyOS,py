        y = self.root.winfo_rooty() + self.root.winfo_height() - TASKBAR_H - H - 10
        m.geometry(f"{W}x{H}+{x}+{max(self.root.winfo_rooty(), y)}")

        canvas = tk.Canvas(m, width=W, height=H, bg=BG_DESKTOP,
