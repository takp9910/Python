class NetManager:
    """Виртуальная сеть: хосты, DNS, сокеты-очереди, fetch."""

    def __init__(self) -> None:
        self.hosts: dict[str, str] = {"localhost": "127.0.0.1"}
        self._next_ip = 1
        self._listeners: dict[int, list[str]] = {}
        self._lock = threading.Lock()

    def add_host(self, name: str) -> str:
        if name in self.hosts:
            return self.hosts[name]
        ip = f"10.0.0.{self._next_ip}"
        self._next_ip += 1
        self.hosts[name] = ip
        return ip

    def resolve(self, name: str) -> Optional[str]:
        return self.hosts.get(name)

    def ping(self, name: str) -> list[str]:
        ip = self.resolve(name)
        if ip is None:
            raise PyOSError(f"неизвестный хост: {name}")
        lines = [f"PING {name} ({ip}) 56(84) bytes of data."]
        for i in range(4):
            t = random.uniform(2, 25)
            lines.append(f"64 bytes from {ip}: icmp_seq={i+1} ttl=64 time={t:.1f} ms")
        lines.append(f"--- {name} ping statistics ---")
        lines.append("4 packets transmitted, 4 received, 0% packet loss")
        return lines

    def listen(self, port: int) -> None:
        with self._lock:
            self._listeners.setdefault(port, [])

    def send(self, host: str, port: int, msg: str) -> None:
        if self.resolve(host) is None:
            raise PyOSError(f"неизвестный хост: {host}")
        with self._lock:
            self._listeners.setdefault(port, []).append(msg)

    def recv(self, port: int) -> list[str]:
        with self._lock:
            msgs = list(self._listeners.get(port, []))
            self._listeners[port] = []
        return msgs

    def fetch(self, url: str) -> str:
        if not re.match(r"https?://", url):
            url = "http://" + url
        m = re.match(r"https?://([^/]+)(/.*)?$", url)
        if not m:
            raise PyOSError("неверный URL")
        host, path = m.group(1), m.group(2) or "/"
        if host not in self.hosts and host not in ("localhost", "pyos.local"):
            raise PyOSError(f"не удалось разрешить хост: {host}")
        return f"HTTP/1.1 200 OK\r\nHost: {host}\r\n\r\n<виртуальная страница {path}>"


