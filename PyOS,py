_BIN_OPS = {
    ast.Add: operator.add, ast.Sub: operator.sub, ast.Mult: operator.mul,
    ast.Div: operator.truediv, ast.FloorDiv: operator.floordiv,
    ast.Mod: operator.mod, ast.Pow: operator.pow,
}
_UN_OPS = {ast.USub: operator.neg, ast.UAdd: operator.pos}


def safe_eval(expr: str):
    """Безопасно вычисляет арифметическое выражение."""
    def ev(node, depth=0):
        if depth > 40:
            raise ValueError("выражение слишком сложное")
        if isinstance(node, ast.Expression):
            return ev(node.body, depth + 1)
        if isinstance(node, ast.Constant) and type(node.value) in (int, float):
            if abs(node.value) > 10**12:
                raise ValueError("слишком большое число")
            return node.value
        if isinstance(node, ast.BinOp) and type(node.op) in _BIN_OPS:
            left, right = ev(node.left, depth + 1), ev(node.right, depth + 1)
            if type(node.op) is ast.Pow:
                if abs(right) > 100 or abs(left) > 10**6:
                    raise ValueError("слишком большая степень")
                return left ** right
            r = _BIN_OPS[type(node.op)](left, right)
            if isinstance(r, (int, float)) and abs(r) > 10**12:
                raise ValueError("результат слишком большой")
            return r
        if isinstance(node, ast.UnaryOp) and type(node.op) in _UN_OPS:
            return _UN_OPS[type(node.op)](ev(node.operand, depth + 1))
        raise ValueError("недопустимое выражение")
    return ev(ast.parse(expr.strip(), mode="eval"))


def fmt_num(x) -> str:
    """Форматирует число (0.1+0.2 -> 0.3, 4.0 -> 4)."""
    if isinstance(x, float):
        if x != x or x in (float("inf"), float("-inf")):
            return str(x)
        x = round(x, 10)
        if x.is_integer():
            return str(int(x))
    return str(x)


def now_iso() -> str:
    return datetime.datetime.now().isoformat(timespec="seconds")


def human_size(n: int) -> str:
    for unit in ("B", "K", "M", "G"):
        if n < 1024:
            return f"{n}{unit}"
        n //= 1024
    return f"{n}T"


def parse_mode(text: str) -> int:
    """Парсит '755' или 'rwxr-xr-x' в число 0..0o777."""
    text = text.strip()
    if re.fullmatch(r"[0-7]{3,4}", text):
        return int(text, 8) & 0o777
    if len(text) == 9:
        mode = 0
        for i, ch in enumerate(text):
            if ch != "-":
                mode |= 1 << (8 - i)
        return mode
    raise ValueError("неверный формат прав")


def mode_str(mode: int) -> str:
    """Возвращает 'rwxr-xr-x'."""
    chars = []
    for shift in (6, 3, 0):
        bits = (mode >> shift) & 0b111
        chars.append("r" if bits & 4 else "-")
        chars.append("w" if bits & 2 else "-")
        chars.append("x" if bits & 1 else "-")
    return "".join(chars)


