class BootScreen:
    STEPS = [
        "Загрузка ядра PyOS 3.0...",
        "Инициализация виртуальной ФС...",
        "Запуск диспетчера процессов...",
        "Подключение пользователей...",
        "Запуск планировщика...",
        "Инициализация сети...",
        "Загрузка пакетов...",
        "Подготовка рабочего стола...",
        "Добро пожаловать",
    ]

    def __init__(self, root, on_done) -> None:
        self.on_done = on_done
        self.top = tk.Toplevel(root)
        self.top.overrideredirect(True)
        self.top.configure(bg="black")
        self.top.attributes("-topmost", True)
        w, h = root.winfo_screenwidth(), root.winfo_screenheight()
        self.top.geometry(f"{w}x{h}+0+0")
        box = tk.Frame(self.top, bg="black")
        box.place(relx=0.5, rely=0.45, anchor="center")
        tk.Label(box, text="🐍", bg="black", fg="#7dd3fc",
                 font=("Segoe UI", 64)).pack()
        tk.Label(box, text="PyOS", bg="black", fg="white",
                 font=("Segoe UI", 42, "bold")).pack()
        tk.Label(box, text=VERSION, bg="black", fg="#7a8a99",
                 font=("Segoe UI", 12)).pack(pady=(0, 30))
        self.welcome = tk.Label(box, text="", bg="black", fg="#7dd3fc",
                                font=("Segoe UI", 24, "bold"))
        self.welcome.pack(pady=(0, 18))
        self.bar = ttk.Progressbar(box, length=460, mode="determinate",
                                   maximum=len(self.STEPS))
        self.bar.pack(pady=(0, 10))
        self.msg = tk.Label(box, text="", bg="black", fg="#556677",
                            font=("Consolas", 10))
        self.msg.pack()
        self.step = 0
        self.top.after(400, self._next)

    def _next(self) -> None:
        if self.step >= len(self.STEPS):
            self.top.after(500, self._finish)
            return
        text = self.STEPS[self.step]
        self.bar["value"] = self.step + 1
        self.msg.config(text=text)
        if text == "Добро пожаловать":
            self.welcome.config(text="Добро пожаловать!")
        self.step += 1
        self.top.after(random.randint(200, 500), self._next)

    def _finish(self) -> None:
        try:
            self.top.destroy()
        except tk.TclError:
            pass
        self.on_done()


class LoginScreen:
    WEEKDAYS = ["понедельник", "вторник", "среда", "четверг",
                "пятница", "суббота", "воскресенье"]
    MONTHS = ["января", "февраля", "марта", "апреля", "мая", "июня",
              "июля", "августа", "сентября", "октября", "ноября", "декабря"]

    def __init__(self, root, kernel, on_done) -> None:
        self.kernel = kernel
        self.on_done = on_done
        self.top = tk.Toplevel(root)
        self.top.overrideredirect(True)
        self.top.attributes("-topmost", True)
        self.top.configure(bg="#0b1220")
        w, h = root.winfo_screenwidth(), root.winfo_screenheight()
        self.top.geometry(f"{w}x{h}+0+0")
        self.h = h
        self._pw_frame = None
        self._tiles_built = False

        self.clock_lbl = tk.Label(self.top, bg="#0b1220", fg="white",
                                  font=("Segoe UI", 64, "bold"))
        self.clock_lbl.place(relx=0.5, y=int(h * 0.26), anchor="center")
        self.date_lbl = tk.Label(self.top, bg="#0b1220", fg="#9fb3c8",
                                 font=("Segoe UI", 20))
        self.date_lbl.place(relx=0.5, y=int(h * 0.26) + 72, anchor="center")
        self._tick()

        tk.Label(self.top, text="Выберите пользователя", bg="#0b1220",
                 fg="#7dd3fc", font=("Segoe UI", 14)
                 ).place(relx=0.5, y=int(h * 0.52), anchor="center")
        self.box = tk.Frame(self.top, bg="#0b1220")
        self.box.place(relx=0.5, y=int(h * 0.64), anchor="center")
        self.error = tk.Label(self.top, bg="#0b1220", fg="#ef4444", font=FONT)
        self.error.place(relx=0.5, y=int(h * 0.64) + 130, anchor="center")
        self._build_tiles()

    def _tick(self) -> None:
        try:
            now = datetime.datetime.now()
            self.clock_lbl.config(text=now.strftime("%H:%M"))
            self.date_lbl.config(
                text=f"{self.WEEKDAYS[now.weekday()]}, "
                     f"{now.day} {self.MONTHS[now.month - 1]}")
            self.top.after(1000, self._tick)
        except tk.TclError:
            pass

    def _build_tiles(self) -> None:
        if self._tiles_built:
            return
        self._tiles_built = True
        for i, (name, info) in enumerate(self.kernel.users.users.items()):
            avatar = "🛡" if info.role == "admin" else "👤"
            tile = tk.Button(
                self.box, text=f"{avatar}\n{name}", command=lambda n=name: self._pick(n),
                bg="#16233a", fg="#cfe3ff", activebackground="#1f3252",
                activeforeground="white", bd=0, relief="flat", cursor="hand2",
                width=10, height=4, font=FONT_BOLD, justify="center")
            tile.grid(row=0, column=i, padx=10)
            tile.bind("<Enter>", lambda e, btn=tile: self._paint((btn,), "#1f3252"))
            tile.bind("<Leave>", lambda e, btn=tile: self._paint((btn,), "#16233a"))

    @staticmethod
    def _paint(widgets, color):
        for wd in widgets:
            try:
                wd.config(bg=color)
            except tk.TclError:
                pass

    def _pick(self, name: str) -> None:
        self.error.config(text="")
        info = self.kernel.users.users[name]
        if info.password_hash is None:
            self._login(name, "")
            return
        if self._pw_frame is not None:
            self._pw_frame.destroy()
        self._pw_frame = tk.Frame(self.top, bg="#0b1220")
        self._pw_frame.place(relx=0.5, y=int(self.h * 0.64), anchor="center")
        tk.Label(self._pw_frame, text=f"🔑  {name}", bg="#0b1220",
                 fg="#cfe3ff", font=FONT).pack()
        entry = tk.Entry(self._pw_frame, show="•", font=FONT, bd=0,
                         justify="center", bg="#16233a", fg="white",
                         insertbackground="white")
        entry.pack(pady=(10, 6), ipady=5)
        actions = tk.Frame(self._pw_frame, bg="#0b1220")
        actions.pack()
        tk.Button(actions, text="Войти", command=lambda: self._login(name, entry.get()),
                  bg=ACCENT, fg="white", activebackground=ACCENT_DARK,
                  activeforeground="white", bd=0, padx=18, pady=5,
                  font=FONT_BOLD).pack(side="left", padx=4)
        tk.Button(actions, text="Отмена", command=self._clear_password,
                  bg="#16233a", fg="#cfe3ff", activebackground="#1f3252",
                  activeforeground="white", bd=0, padx=14, pady=5,
                  font=FONT).pack(side="left", padx=4)
        entry.bind("<Return>", lambda e: self._login(name, entry.get()))
        entry.focus_set()

    def _clear_password(self) -> None:
        if self._pw_frame is not None:
            self._pw_frame.destroy()
            self._pw_frame = None
        self.error.config(text="")

    def _login(self, name: str, pwd: str) -> None:
        ok, msg = self.kernel.users.login(name, pwd)
        if ok:
            try:
                self.top.destroy()
            except tk.TclError:
                pass
            self.on_done()
        else:
            self.error.config(text="✕ " + msg)
            if self._pw_frame is not None:
                self._pw_frame.destroy()
                self._pw_frame = None


