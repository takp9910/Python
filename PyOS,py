def open_files(desktop, *_) -> None:
    """Двухпанельный проводник с копированием выбранного файла."""
    w = AppWindow(desktop, "Файлы", "📁", mem=11)
    kernel = desktop.os

    panel = tk.Frame(w.body, bg=BG_WINDOW)
    panel.pack(fill="both", expand=True)
    panes: dict[str, tuple] = {}

    def make_pane(parent, initial_parts, side):
        cur = [list(initial_parts)]
        frame = tk.Frame(parent, bg=BG_WINDOW)
        frame.pack(side="left", fill="both", expand=True, padx=4)
        path_var = tk.StringVar()
        entry = tk.Entry(frame, textvariable=path_var, font=("Consolas", 10))
        entry.pack(fill="x")
        lb = tk.Listbox(frame, font=("Consolas", 11), bd=0)
        lb.pack(fill="both", expand=True)

        def here():
            return "/" + "/".join(cur[0]) if cur[0] else "/"

        def refresh():
            path_var.set(here())
            lb.delete(0, "end")
            try:
                for name in kernel.vfs.names(here(), show_hidden=True):
                    lb.insert("end", name)
            except VFSError:
                pass

        def go(event):
            parts = kernel.vfs.resolve(path_var.get().strip())
            node = kernel.vfs._get(parts)
            if node and node.kind == "dir":
                cur[0] = parts
                refresh()

        def open_sel(event=None):
            sel = lb.curselection()
            if not sel:
                return
            name = lb.get(sel[0]).rstrip("/@")
            target = here().rstrip("/") + "/" + name
            node = kernel.vfs._get(kernel.vfs.resolve(target))
            if node and node.kind == "dir":
                cur[0] = kernel.vfs.resolve(target)
                refresh()
            else:
                desktop.launch_from_os("edit", target)

        entry.bind("<Return>", go)
        lb.bind("<Double-1>", open_sel)
        refresh()
        panes[side] = {"refresh": refresh, "lb": lb, "cur": cur}

    make_pane(panel, kernel.vfs.cwd, "left")
    make_pane(panel, kernel.vfs.cwd, "right")

    def copy_selected(src_side, dst_side):
        src = panes[src_side]
        dst = panes[dst_side]
        sel = src["lb"].curselection()
        if not sel:
            return
        name = src["lb"].get(sel[0]).rstrip("/@")
        src_path = ("/" + "/".join(src["cur"][0])).rstrip("/") + "/" + name
        dst_path = ("/" + "/".join(dst["cur"][0])).rstrip("/") + "/" + name
        try:
            node = kernel.vfs._get(kernel.vfs.resolve(src_path))
            if node and node.kind == "dir":
                messagebox.showinfo("Файлы", "Копирование папок не поддерживается",
                                    parent=w)
                return
            data = kernel.vfs.read(src_path)
            kernel.vfs.write(dst_path, data)
        except (VFSError, PermError) as e:
            messagebox.showerror("Файлы", str(e), parent=w)
            return
        panes["left"]["refresh"]()
        panes["right"]["refresh"]()

    def selected_path(side):
        pane = panes[side]
        sel = pane["lb"].curselection()
        if not sel:
            return None
        name = pane["lb"].get(sel[0]).rstrip("/@")
        return ("/" + "/".join(pane["cur"][0])).rstrip("/") + "/" + name

    def go_up(side):
        pane = panes[side]
        if pane["cur"][0]:
            pane["cur"][0] = pane["cur"][0][:-1]
            pane["refresh"]()

    def new_folder(side):
        pane = panes[side]
        name = simpledialog.askstring("Новая папка", "Имя папки:", parent=w)
        if not name or "/" in name or name in (".", ".."):
            return
        path = ("/" + "/".join(pane["cur"][0])).rstrip("/") + "/" + name
        try:
            kernel.vfs.mkdir(path)
            pane["refresh"]()
        except (VFSError, PermError) as e:
            messagebox.showerror("Файлы", str(e), parent=w)

    def delete_selected(side):
        path = selected_path(side)
        if not path:
            return
        if not messagebox.askyesno("Удаление", f"Удалить {path}?", parent=w):
            return
        try:
            kernel.vfs.rm(path, recursive=True)
            panes[side]["refresh"]()
        except (VFSError, PermError) as e:
            messagebox.showerror("Файлы", str(e), parent=w)

    def move_selected(src_side, dst_side):
        src_path = selected_path(src_side)
        if not src_path:
            return
        src = panes[src_side]
        dst = panes[dst_side]
        name = src_path.rsplit("/", 1)[-1]
        dst_path = ("/" + "/".join(dst["cur"][0])).rstrip("/") + "/" + name
        try:
            node = kernel.vfs._get(kernel.vfs.resolve(src_path))
            if node and node.kind == "dir":
                messagebox.showinfo("Файлы", "Перемещение папок пока не поддерживается",
                                    parent=w)
                return
            kernel.vfs.write(dst_path, kernel.vfs.read(src_path))
            kernel.vfs.rm(src_path, trash=False)
            src["refresh"]()
            dst["refresh"]()
        except (VFSError, PermError) as e:
            messagebox.showerror("Файлы", str(e), parent=w)

    bar = tk.Frame(w.body, bg=BG_WINDOW)
    bar.pack(fill="x")
    tk.Button(bar, text="🔄 Обновить",
              command=lambda: (panes["left"]["refresh"](),
                               panes["right"]["refresh"]())).pack(side="left")
    tk.Button(bar, text="← Копировать",
              command=lambda: copy_selected("left", "right")).pack(side="left", padx=4)
    tk.Button(bar, text="→ Копировать",
              command=lambda: copy_selected("right", "left")).pack(side="left")
    tk.Button(bar, text="↑ Вверх слева", command=lambda: go_up("left")).pack(side="left", padx=4)
    tk.Button(bar, text="↑ Вверх справа", command=lambda: go_up("right")).pack(side="left")
