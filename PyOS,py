            elif sub == "listen" and len(args) >= 2:
                self.k.net.listen(int(args[1]))
                self.ok("слушаем")
            elif sub == "send" and len(args) >= 3:
                host, port = args[1].split(":")
                self.k.net.send(host, int(port), " ".join(args[2:]))
                self.ok("отправлено")
            elif sub == "recv" and len(args) >= 2:
                for m in self.k.net.recv(int(args[1])):
                    self._print(m)
            else:
                self.err("неизвестная подкоманда net")
        except (PyOSError, ValueError) as e:
            self.err(str(e))

    # ---------- пакеты ----------
    def cmd_pkg(self, args) -> None:
        if not args:
            self.err("pkg list|search <q>|repo [url]|update|install <name>|remove <name>")
            return
        sub = args[0]
        try:
            if sub == "list":
                items = self.k.packages.list_installed()
                if not items:
                    self._print("(нет установленных пакетов)")
                for n in items:
                    self._print(n)
            elif sub == "search":
                for n, d in self.k.packages.search(args[1] if len(args) > 1 else ""):
                    self._print(f"{n:<12}{d}")
            elif sub == "repo":
                if len(args) > 1:
                    self.k.packages.set_repo(args[1])
                self._print(self.k.packages.repo_url or "(репозиторий не задан)")
            elif sub == "update":
                count = self.k.packages.update(args[1] if len(args) > 1 else None)
                self.k.save_state()
                self.ok(f"каталог обновлён: {count} пакетов")
            elif sub == "install" and len(args) >= 2:
                if not self.k.users.is_admin():
                    self.err("нужен root")
                    return
                self.k.packages.install(args[1])
                self.ok(f"установлен: {args[1]}")
            elif sub == "remove" and len(args) >= 2:
                if not self.k.users.is_admin():
                    self.err("нужен root")
                    return
                self.k.packages.remove(args[1])
                self.ok("удалён")
            else:
                self.err("неизвестная подкоманда pkg")
        except PyOSError as e:
            self.err(str(e))

