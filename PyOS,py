                        "net listen <port> | net send <host:port> <msg> | net recv <port>")
            return
        sub = args[0]
        try:
            if sub == "host" and len(args) >= 3 and args[1] == "add":
                ip = self.k.net.add_host(args[2])
                self.ok(f"{args[2]} -> {ip}")
            elif sub == "resolve" and len(args) >= 2:
                ip = self.k.net.resolve(args[1])
