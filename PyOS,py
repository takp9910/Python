    def cmd_logs(self, args) -> None:
        try:
            data = self.k.vfs.read("/var/log/pyos.log")
        except VFSError:
            self.err("лог пуст")
            return
        lines = data.splitlines()
        level = None
        tail = 30
        if "--tail" in args:
            i = args.index("--tail")
            try:
                tail = int(args[i + 1])
            except (IndexError, ValueError):
                pass
        if "--level" in args:
            i = args.index("--level")
            if i + 1 < len(args):
                level = args[i + 1]
        for line in lines[-tail:]:
            if level and f"[{level}]" not in line:
                continue
            self._print(line)

    def cmd_fsck(self, args) -> None:
        issues = 0
        for parts, node in self.k.vfs.walk("/"):
            if node.kind == "dir":
                for name in list(node.children.keys()):
                    if not isinstance(name, str):
                        del node.children[name]
                        issues += 1
        self.ok(f"fsck завершён, проблем: {issues}")

    def cmd_selftest(self, args) -> None:
        checks = []
        try:
            self.k.vfs.write("/tmp/_selftest", "ok", system=True)
            assert self.k.vfs.read("/tmp/_selftest") == "ok"
            self.k.vfs.rm("/tmp/_selftest", trash=False)
            checks.append(("VFS", True))
        except Exception:
            checks.append(("VFS", False))
        try:
            pid = self.k.procs.spawn("selftest", 1, self.k.users.current)
            self.k.procs.kill(pid)
            checks.append(("Procs", True))
        except Exception:
            checks.append(("Procs", False))
        try:
            jid = self.k.scheduler.add_at("+1", "echo test")
            self.k.scheduler.remove(jid)
            checks.append(("Scheduler", True))
        except Exception:
            checks.append(("Scheduler", False))
        try:
            ip = self.k.net.add_host("selftest-host")
            assert self.k.net.resolve("selftest-host") == ip
            checks.append(("Net", True))
        except Exception:
            checks.append(("Net", False))
        try:
            self.k.packages.search("hello")
            checks.append(("Packages", True))
        except Exception:
            checks.append(("Packages", False))
        for name, ok in checks:
            self._print(f"[{'OK' if ok else 'FAIL'}] {name}")

