def open_monitor(desktop, *_) -> None:
    w = AppWindow(desktop, "Монитор", "📈", mem=10)
    kernel = desktop.os
    canvas = tk.Canvas(w.body, bg="#0b1220", highlightthickness=0)
    canvas.pack(fill="both", expand=True)
    info = tk.Label(w.body, bg="#0b1220", fg="#7dd3fc",
                    font=("Consolas", 11), justify="left", anchor="w")
    info.pack(fill="x")
    cpu_hist = [0.0] * 60
    mem_hist = [0] * 60

    def tick():
        if w._closed:
            return
        try:
            cpu = random.uniform(5, 60)
            mem = kernel.procs.total_mem()
            cpu_hist.pop(0)
            cpu_hist.append(cpu)
            mem_hist.pop(0)
            mem_hist.append(mem)
            canvas.delete("all")
            W = canvas.winfo_width() or 600
            H = canvas.winfo_height() or 260
            canvas.create_text(8, 8, anchor="nw", fill="#7dd3fc",
                               text=f"CPU {cpu:.1f}%   RAM {mem} MB   "
                                    f"PROC {len(kernel.procs.procs)}",
                               font=("Consolas", 11))
            for i in range(1, len(cpu_hist)):
                x1 = W * (i - 1) / len(cpu_hist)
                x2 = W * i / len(cpu_hist)
                y1 = H - (cpu_hist[i - 1] / 100) * (H - 30)
                y2 = H - (cpu_hist[i] / 100) * (H - 30)
                canvas.create_line(x1, y1, x2, y2, fill="#22c55e", width=2)
                ym1 = H - (mem_hist[i - 1] / 512) * (H - 30)
                ym2 = H - (mem_hist[i] / 512) * (H - 30)
                canvas.create_line(x1, ym1, x2, ym2, fill="#3b82f6", width=2)
            info.config(text=f"Процессов: {len(kernel.procs.procs)}   Память: {mem}/512 MB")
        except tk.TclError:
            return
        w.after(500, tick)

    tick()


def open_computer(desktop, path="/", *_) -> None:
    w = AppWindow(desktop, "Этот компьютер", "💻", mem=11)
    kernel = desktop.os
    path_var = tk.StringVar(value=path or "/")
    tk.Entry(w.body, textvariable=path_var, font=("Consolas", 10)).pack(fill="x")
    lb = tk.Listbox(w.body, font=("Consolas", 11), bd=0)
    lb.pack(fill="both", expand=True, pady=6)

    def refresh():
        lb.delete(0, "end")
        current = path_var.get().strip() or "/"
        try:
            node = kernel.vfs._get(kernel.vfs.resolve(current))
            if node is None or node.kind != "dir":
                raise VFSError("нет такой директории")
            if current != "/":
                lb.insert("end", "../")
            for name in kernel.vfs.names(current, show_hidden=True):
                lb.insert("end", name)
        except VFSError as e:
            lb.insert("end", str(e))

    def open_selected(event=None):
        sel = lb.curselection()
        if not sel:
            return
        name = lb.get(sel[0]).rstrip("/@")
        current = path_var.get().strip().rstrip("/")
        target = "/" + "/".join(kernel.vfs.resolve(current + "/" + name))
        if name == "..":
            target = "/" + "/".join(kernel.vfs.resolve(current + "/.."))
        node = kernel.vfs._get(kernel.vfs.resolve(target))
        if node and node.kind == "dir":
            path_var.set(target)
            refresh()
        elif node:
            desktop.launch_from_os("edit", target)

    tk.Button(w.body, text="🔄 Обновить", command=refresh).pack(side="bottom")
    lb.bind("<Double-1>", open_selected)
    path_var.trace_add("write", lambda *_: refresh())
    refresh()


