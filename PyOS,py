class User:
    def __init__(self, name: str, password_hash: Optional[str] = None,
                 role: str = "user", groups: Optional[list[str]] = None,
                 home: str = "/home/user") -> None:
        self.name = name
        self.password_hash = password_hash
        self.role = role
        self.groups = groups or [name]
        self.home = home


class UserManager:
    """Пользователи, группы, sudo, права по user/group/other."""

    def __init__(self, logger: Logger) -> None:
        self.logger = logger
        self.users: dict[str, User] = {
            "guest": User("guest", None, "guest", ["guest"], "/home/guest"),
            "user": User("user", self._h("1234"), "user", ["user", "users"], "/home/user"),
            "root": User("root", self._h("toor"), "admin", ["root", "wheel"], "/root"),
        }
        self.groups: dict[str, list[str]] = {
            "root": ["root"], "wheel": ["root"], "users": ["user"],
            "user": ["user"], "guest": ["guest"],
        }
        self.current = "guest"

    @staticmethod
    def _h(s: str) -> str:
        return hashlib.sha256(s.encode()).hexdigest()

    def role(self) -> str:
        return self.users[self.current].role

    def is_admin(self) -> bool:
        return self.role() == "admin"

    def login(self, name: str, password: str = ""):
        u = self.users.get(name)
        if u is None:
            return False, "нет такого пользователя"
        if u.password_hash is None or self._h(password) == u.password_hash:
            self.current = name
            self.logger.info(f"login: {name}")
            return True, f"вошли как {name}"
        return False, "неверный пароль"

    def whoami(self) -> str:
        return self.current

    def prompt(self) -> str:
        return f"{self.current}@pyos{'#' if self.is_admin() else '$'}"

    def add_group(self, group: str) -> None:
        self.groups.setdefault(group, [])

    def add_user_to_group(self, user: str, group: str) -> None:
        self.groups.setdefault(group, [])
        if user not in self.groups[group]:
            self.groups[group].append(user)
        if user in self.users and group not in self.users[user].groups:
            self.users[user].groups.append(group)

    def user_groups(self, user: str) -> list[str]:
        return list(self.users[user].groups) if user in self.users else []

    def set_password(self, user: str, pwd: str) -> None:
        if user not in self.users:
            raise PyOSError("нет такого пользователя")
        self.users[user].password_hash = self._h(pwd)

    def check_perm(self, node: FileNode, need: str) -> bool:
        """need: 'r'|'w'|'x'. root всегда может."""
        if self.current == "root":
            return True
        need_bit = {"r": 4, "w": 2, "x": 1}[need]
        if node.owner == self.current:
            return bool((node.mode >> 6) & need_bit)
        if node.group in self.user_groups(self.current):
            return bool((node.mode >> 3) & need_bit)
        return bool(node.mode & need_bit)


