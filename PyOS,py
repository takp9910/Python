class AchievementManager:
    """Steam-подобные достижения PyOS с сохранением разблокировок."""

    DEFINITIONS = {
        "welcome": ("Первые шаги", "Запустить игру в PyOS"),
        "2048_128": ("Сила двойки", "Собрать плитку 128 в 2048"),
        "2048_2048": ("Мастер 2048", "Собрать плитку 2048"),
        "snake_10": ("Аппетит приходит", "Набрать 10 очков в Змейке"),
        "snake_50": ("Змеиный чемпион", "Набрать 50 очков в Змейке"),
        "tetris_line": ("Первая линия", "Очистить линию в Тетрисе"),
        "tetris_100": ("Падающий мастер", "Набрать 100 очков в Тетрисе"),
        "minesweeper_win": ("Сапёр ошибается один раз", "Победить в Сапёре"),
        "minesweeper_boom": ("Бум!", "Подорваться на мине"),
    }

    def __init__(self, kernel: "Kernel") -> None:
        self.kernel = kernel
        self.unlocked: dict[str, str] = {}

    def load(self, data: Any) -> None:
        if isinstance(data, dict):
            self.unlocked = {k: str(v) for k, v in data.items()
                             if k in self.DEFINITIONS}

    def unlock(self, key: str) -> bool:
        if key not in self.DEFINITIONS or key in self.unlocked:
            return False
        self.unlocked[key] = now_iso()
        title, description = self.DEFINITIONS[key]
        message = f"🏆 {title}\n{description}"
        if self.kernel.desktop_notify:
            self.kernel.desktop_notify("ДОСТИЖЕНИЕ РАЗБЛОКИРОВАНО", message)
        else:
            self.kernel.logger.info(f"achievement unlocked: {title} — {description}")
        self.kernel.save_state()
        return True

    def is_unlocked(self, key: str) -> bool:
        return key in self.unlocked


