class FileNode:
    """Узел ФС: файл, директория или симлинк с метаданными."""

    def __init__(self, kind: str = "file", content: str = "",
                 owner: str = "user", group: str = "user",
                 mode: int = 0o644, link_target: Optional[str] = None,
                 hidden: bool = False, readonly: bool = False,
                 executable: bool = False) -> None:
        self.kind = kind
        self.content = content
        self.children: dict[str, "FileNode"] = {}
        self.owner = owner
        self.group = group
        self.mode = mode
        self.ctime = self.mtime = time.time()
        self.hidden = hidden
        self.readonly = readonly
        self.executable = executable
        self.link_target = link_target

    def to_json(self) -> dict:
        d = {
            "kind": self.kind, "content": self.content,
            "owner": self.owner, "group": self.group, "mode": self.mode,
            "ctime": self.ctime, "mtime": self.mtime,
            "hidden": self.hidden, "readonly": self.readonly,
            "executable": self.executable, "link_target": self.link_target,
        }
        if self.kind == "dir":
            d["children"] = {k: v.to_json() for k, v in self.children.items()}
        return d

    @classmethod
    def from_json(cls, d: dict) -> "FileNode":
        node = cls(kind=d.get("kind", "file"),
                   content=d.get("content", ""),
                   owner=d.get("owner", "user"),
                   group=d.get("group", "user"),
                   mode=d.get("mode", 0o644),
                   link_target=d.get("link_target"),
                   hidden=d.get("hidden", False),
                   readonly=d.get("readonly", False),
                   executable=d.get("executable", False))
        node.ctime = d.get("ctime", time.time())
        node.mtime = d.get("mtime", time.time())
        for k, v in d.get("children", {}).items():
            node.children[k] = cls.from_json(v)
        return node


class VFS:
    """Виртуальная ФС в памяти: метаданные, права, симлинки, корзина."""

    PROTECTED = ("/etc", "/bin", "/usr", "/var", "/mnt")

    MAX_LINK_HOPS = 40

    def __init__(self) -> None:
        self.root = FileNode(kind="dir", owner="root", group="root", mode=0o755)
        self.cwd: list[str] = ["home", "guest"]
        # Хуки, устанавливаются Kernel'ом после сборки всех подсистем
        self._perm_checker: Optional[Callable[[FileNode, str], bool]] = None
        self._current_user_fn: Callable[[], str] = lambda: "user"
        self._init_tree()

    def set_perm_checker(self, checker: Callable[[FileNode, str], bool]) -> None:
        self._perm_checker = checker

    def set_current_user_provider(self, fn: Callable[[], str]) -> None:
        self._current_user_fn = fn

    def _init_tree(self) -> None:
        def add(path: str, node: FileNode) -> None:
            parts = [p for p in path.split("/") if p]
            cur = self.root
            for p in parts[:-1]:
                cur = cur.children.setdefault(p, FileNode(kind="dir", owner="root",
                                                          group="root", mode=0o755))
            cur.children[parts[-1]] = node

        add("/home/guest", FileNode(kind="dir", owner="guest", group="guest", mode=0o755))
        add("/home/user", FileNode(kind="dir", owner="user", group="user", mode=0o755))
        add("/home/user/readme.txt",
            FileNode(content="Добро пожаловать в PyOS 3.0!\nВведите help.\n", owner="user"))
        add("/home/user/notes.txt",
            FileNode(content="Мои заметки:\n- изучить Python\n", owner="user"))
        add("/home/user/.trash", FileNode(kind="dir", owner="user", mode=0o755))
        add("/home/user/.config", FileNode(kind="dir", owner="user", mode=0o755))
        add("/root", FileNode(kind="dir", owner="root", group="root", mode=0o700))
        add("/etc/motd", FileNode(content=f"{VERSION} — приятной работы!\n",
                                  owner="root", mode=0o644))
        add("/etc/rc.local", FileNode(content="# автозапуск\n", owner="root"))
        add("/etc/passwd", FileNode(
            content="guest:x:0:0::/home/guest\nuser:x:1000:1000::/home/user\nroot:x:0:0::/root\n",
            owner="root"))
        add("/usr/bin", FileNode(kind="dir", owner="root"))
        add("/var/log", FileNode(kind="dir", owner="root"))
        add("/mnt", FileNode(kind="dir", owner="root"))
        add("/public/index.html", FileNode(
            content="<h1>PyOS Public</h1><p>Виртуальный веб-сервер.</p>", owner="root"))
        add("/bin", FileNode(kind="dir", owner="root"))
        add("/tmp", FileNode(kind="dir", owner="root", mode=0o777))

    # ---------- экспорт/импорт ----------
    def export_state(self) -> dict:
        return {"root": self.root.to_json(), "cwd": list(self.cwd)}

    def import_state(self, state: dict) -> None:
        if not isinstance(state, dict):
            return
        root = state.get("root")
        if not isinstance(root, dict):
            return
        try:
            self.root = FileNode.from_json(root)
            cwd = state.get("cwd", ["home", "guest"])
            if isinstance(cwd, list) and all(isinstance(p, str) for p in cwd):
                self.cwd = cwd
        except Exception:
            pass

    # ---------- пути ----------
    def resolve(self, path: Optional[str]) -> list[str]:
        if not path:
            return list(self.cwd)
        raw = [p for p in path.split("/") if p]
        parts = raw if path.startswith("/") else self.cwd + raw
        out: list[str] = []
        for p in parts:
            if p == ".":
                continue
            if p == "..":
                if out:
                    out.pop()
                continue
            out.append(p)
        return out

    def _get(self, parts: list[str]) -> Optional[FileNode]:
        """Возвращает узел с разрешением симлинков (с ограничением глубины)."""
        node = self.root
        hops = 0
        for index, p in enumerate(parts):
            if node.kind != "dir" or p not in node.children:
                return None
            node = node.children[p]
            while node.kind == "link":
                hops += 1
                if hops > self.MAX_LINK_HOPS or not node.link_target:
                    return node  # битая ссылка или цикл — возвращаем как есть
                target = node.link_target
                if target.startswith("/"):
                    new_parts = [x for x in target.split("/") if x]
                else:
                    # Относительная ссылка разрешается от каталога самой ссылки,
                    # а не от текущего каталога оболочки.
                    new_parts = list(parts[:index])
                    for component in target.split("/"):
                        if component in ("", "."):
                            continue
                        if component == "..":
                            if new_parts:
                                new_parts.pop()
                        else:
                            new_parts.append(component)
                node = self.root
                broken = False
                for np in new_parts:
                    if node.kind != "dir" or np not in node.children:
                        broken = True
                        break
                    node = node.children[np]
                if broken:
                    return None
        return node

    def _split(self, path: str):
        parts = self.resolve(path)
        if not parts:
            raise VFSError("некорректный путь")
        parent = self._get(parts[:-1])
        if parent is None or parent.kind != "dir":
            raise VFSError(f"нет такой директории: {'/'.join(parts[:-1]) or '/'}")
        return parent, parts[-1]

    def path_str(self) -> str:
        return "/" + "/".join(self.cwd) if self.cwd else "/"

    # ---------- проверка прав ----------
    def _check_perm(self, node: FileNode, mode: str) -> bool:
        if self._perm_checker is None:
            return True
        return self._perm_checker(node, mode)

    # ---------- операции ----------
    def exists(self, path: str) -> bool:
        return self._get(self.resolve(path)) is not None

    def ls(self, path: Optional[str] = None, show_hidden: bool = False) -> list[FileNode]:
        parts = self.resolve(path)
        node = self._get(parts)
        if node is None:
            raise VFSError(f"нет такого пути: /{'/'.join(parts)}")
        if node.kind != "dir":
            return [node]
        out = []
        for name in sorted(node.children):
            n = node.children[name]
            if n.hidden and not show_hidden:
                continue
            out.append(n)
        return out

    def names(self, path: Optional[str] = None, show_hidden: bool = False) -> list[str]:
        parts = self.resolve(path)
        node = self._get(parts)
        if node is None:
            raise VFSError("нет такого пути")
        if node.kind != "dir":
            return [parts[-1]]
        return [n + ("/" if node.children[n].kind == "dir" else
                     ("@" if node.children[n].kind == "link" else ""))
                for n in sorted(node.children)
                if show_hidden or not node.children[n].hidden]

    def cd(self, path: Optional[str]) -> None:
        parts = self.resolve(path or "/home/user")
        node = self._get(parts)
        if node is None or node.kind != "dir":
            raise VFSError(f"нет такой директории: {path}")
        self.cwd = parts

    def mkdir(self, path: str) -> None:
        parent, name = self._split(path)
        if name in parent.children:
            raise VFSError(f"уже существует: {path}")
        if not self._check_perm(parent, "w"):
            raise PermError(f"нет прав на создание в {path}")
        parent.children[name] = FileNode(kind="dir", owner=self._current_user_fn())
        parent.mtime = time.time()

    def mkdir_p(self, path: str) -> None:
        parts = self.resolve(path)
        cur = self.root
        for p in parts:
            if p not in cur.children:
                cur.children[p] = FileNode(kind="dir", owner=self._current_user_fn())
            cur = cur.children[p]
            if cur.kind != "dir":
                raise VFSError(f"не директория: {p}")

    def touch(self, path: str) -> None:
        parent, name = self._split(path)
        if name not in parent.children:
            if not self._check_perm(parent, "w"):
                raise PermError(f"нет прав на создание: {path}")
            parent.children[name] = FileNode(owner=self._current_user_fn())
        parent.children[name].mtime = time.time()

    def read(self, path: str) -> str:
        node = self._get(self.resolve(path))
        if node is None:
            raise VFSError(f"нет такого файла: {path}")
        if node.kind == "dir":
            raise VFSError(f"это директория: {path}")
        if not self._check_perm(node, "r"):
            raise PermError(f"нет прав на чтение: {path}")
        return node.content

    def write(self, path: str, content: str, system: bool = False) -> None:
        parts = self.resolve(path)
        parent, name = self._split(path)
        node = parent.children.get(name)
        if node and node.kind == "dir":
            raise VFSError(f"это директория: {path}")
        if not system:
            if node is not None:
                if not self._check_perm(node, "w"):
                    raise PermError(f"нет прав на запись: {path}")
            else:
                if not self._check_perm(parent, "w"):
                    raise PermError(f"нет прав на создание: {path}")
        if node is None:
            node = FileNode(owner=self._current_user_fn())
            parent.children[name] = node
        if node.readonly and not system:
            raise PermError(f"файл только для чтения: {path}")
        node.content = content
        node.mtime = time.time()

    def write_bytes(self, path: str, data: bytes) -> None:
        self.write(path, data.decode("latin-1"))

    def read_bytes(self, path: str) -> bytes:
        return self.read(path).encode("latin-1")

    def rm(self, path: str, recursive: bool = False, trash: bool = True) -> None:
        parts = self.resolve(path)
        if not parts:
            raise PermError("нельзя удалить корень")
        parent, name = self._split(path)
        node = parent.children.get(name)
        if node is None:
            raise VFSError(f"нет такого пути: {path}")
        if not self._check_perm(parent, "w"):
            raise PermError(f"нет прав на удаление: {path}")
        if node.kind == "dir" and node.children and not recursive:
            raise VFSError(f"директория не пуста: {path}")
        if trash and not any(p == ".trash" for p in parts):
            trash_dir = self._get(["home", "user", ".trash"])
            if trash_dir and trash_dir.kind == "dir":
                stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S-%f")
                base = f"{stamp}_{name}"
                final = base
                n = 1
                while final in trash_dir.children:
                    final = f"{base}.{n}"
                    n += 1
                trash_dir.children[final] = node
                del parent.children[name]
                parent.mtime = time.time()
                return
        del parent.children[name]
        parent.mtime = time.time()

    # ---------- поиск ----------
    def walk(self, path: Optional[str] = None):
        parts = self.resolve(path)
        node = self._get(parts)
        if node is None:
            return
        visited: set[int] = set()
        stack: list[tuple[list[str], FileNode]] = [(list(parts), node)]
        while stack:
            cur_parts, cur_node = stack.pop()
            nid = id(cur_node)
            if nid in visited:
                continue
            visited.add(nid)
            yield cur_parts, cur_node
            if cur_node.kind == "dir":
                for name in sorted(cur_node.children):
                    stack.append((cur_parts + [name], cur_node.children[name]))

    def find(self, base: str, pattern: str) -> list[str]:
        out = []
        for parts, node in self.walk(base):
            if parts and fnmatch.fnmatch(parts[-1], pattern):
                out.append("/" + "/".join(parts))
        return out

    def trash_list(self) -> list[str]:
        t = self._get(["home", "user", ".trash"])
        if t is None:
            return []
        return sorted(t.children)

    def trash_restore(self, name: str) -> None:
        t = self._get(["home", "user", ".trash"])
        if t is None or name not in t.children:
            raise VFSError("нет такого элемента корзины")
        # имя формата <stamp>_<original> или <stamp>_<original>.<n>
        if "_" not in name:
            raise VFSError("неверный формат имени в корзине")
        target_name = name.split("_", 1)[1]
        # отрезаем суффикс .N, если он был добавлен из-за коллизии
        if "." in target_name:
            head, sep, tail = target_name.rpartition(".")
            if tail.isdigit():
                target_name = head
        home = self._get(["home", "user"])
        if home is None:
            raise VFSError("нет /home/user")
        final = target_name
        n = 1
        while final in home.children:
            final = f"{target_name}.{n}"
            n += 1
        home.children[final] = t.children.pop(name)

    def trash_empty(self) -> int:
        t = self._get(["home", "user", ".trash"])
        if t is None:
            return 0
        n = len(t.children)
        t.children.clear()
        return n

    def is_protected(self, path: str) -> bool:
        parts = self.resolve(path)
        if len(parts) <= 1:
            return True
        s = "/" + "/".join(parts)
        return any(s == p or s.startswith(p + "/") for p in self.PROTECTED)

    def tree_lines(self, path: Optional[str] = None) -> list[str]:
        parts = self.resolve(path)
        node = self._get(parts)
        if node is None:
            raise VFSError("нет такого пути")
        lines = ["/" + "/".join(parts)]
        if node.kind == "dir":
            self._walk_tree(node, "", lines)
        return lines

    def _walk_tree(self, node: FileNode, prefix: str, lines: list[str],
                   visited: Optional[set[int]] = None) -> None:
        if visited is None:
            visited = set()
        if id(node) in visited:
            return
        visited.add(id(node))
        names = sorted(node.children)
        for i, name in enumerate(names):
            last = i == len(names) - 1
            val = node.children[name]
            suffix = "/" if val.kind == "dir" else ("@" if val.kind == "link" else "")
            lines.append(prefix + ("└── " if last else "├── ") + name + suffix)
            if val.kind == "dir":
                self._walk_tree(val, prefix + ("    " if last else "│   "),
                                lines, visited)

    def df(self) -> dict:
        files = dirs = bytes_total = 0
        for _, n in self.walk("/"):
            if n.kind == "dir":
                dirs += 1
            else:
                files += 1
                bytes_total += len(n.content)
        return {"files": files, "dirs": dirs, "bytes": bytes_total}


