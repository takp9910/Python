class Desktop:
    """Рабочий стол с ярлыками, панелью задач, меню Пуск, треем."""

    def __init__(self, root, kernel: Kernel) -> None:
        self.root = root
        self.os = kernel
        self.windows: list = []
        self.taskbar_buttons: dict = {}
        self._toasts: list = []
        self.icons: list = []
        self.start_menu = None
        self._relayout_job = None
        self._last_layout_size = (0, 0)

        kernel.launcher = self.launch_from_os
        kernel.procs.on_kill = self._on_proc_killed
        kernel.desktop_notify = self.notify

        root.title(VERSION)
        root.configure(bg=BG_DESKTOP)
        if "--window" in sys.argv:
            root.geometry("1280x800")
        else:
            root.attributes("-fullscreen", True)
            root.bind("<Escape>", lambda e: root.attributes("-fullscreen", False))
            root.bind("<F11>", lambda e: root.attributes(
                "-fullscreen", not root.attributes("-fullscreen")))

        self.taskbar = tk.Frame(root, bg=BG_TASKBAR, height=TASKBAR_H)
        self.taskbar.pack(fill="x", side="bottom")
        self.taskbar.pack_propagate(False)
        self.canvas = tk.Canvas(root, bg=BG_DESKTOP, highlightthickness=0)
        self.canvas.pack(fill="both", expand=True)
        self.canvas.bind("<Button-3>", self.context_menu)
        self._apply_wallpaper()

        tk.Button(self.taskbar, text="🐍 Пуск", bg=ACCENT, fg="white", font=FONT_BOLD,
                  bd=0, padx=14, activebackground=ACCENT_DARK, activeforeground="white",
                  command=self.toggle_start_menu
                  ).pack(side="left", padx=6, pady=6, fill="y")
        self.tray = tk.Label(self.taskbar, bg=BG_TASKBAR, fg=FG_TASKBAR,
                             font=FONT, text="🔊  🌐  🔋")
        self.tray.pack(side="right", padx=12)
        self.clock = tk.Label(self.taskbar, bg=BG_TASKBAR, fg=FG_TASKBAR, font=FONT_BOLD)
        self.clock.pack(side="right", padx=12)
        center = tk.Frame(self.taskbar, bg=BG_TASKBAR)
        center.pack(side="left", fill="both", expand=True)
        self.task_frame = tk.Frame(center, bg=BG_TASKBAR)
        self.task_frame.place(relx=0.5, rely=0.5, anchor="center")

        self.canvas.bind("<Configure>", self._schedule_layout)
        self.search_var = tk.StringVar()
        self.search_entry = tk.Entry(self.taskbar, textvariable=self.search_var,
                                     bg="#1e2126", fg="white", insertbackground="white",
                                     font=FONT, bd=0, width=22)
        self.search_entry.pack(side="left", padx=(4, 8), pady=8, ipady=2)
        self.search_entry.bind("<Return>", lambda e: self.toggle_start_menu(self.search_var.get()))
        tk.Button(self.taskbar, text="🔎", bg=BG_TASKBAR, fg=FG_TASKBAR, bd=0,
                  command=lambda: self.toggle_start_menu(self.search_var.get())).pack(side="left")
        self.tick()
        self._register_hotkeys()

    def _register_hotkeys(self) -> None:
        self.root.bind_all("<Super_L>", lambda e: self.toggle_start_menu())
        self.root.bind_all("<Control-Alt-l>", lambda e: self.lock_screen())
        self.root.bind_all("<Control-Alt-d>", lambda e: self.show_desktop())
        self.root.bind_all("<Button-1>", self._interface_click, add="+")

    def _interface_click(self, event=None) -> None:
        if not self.os.sound_enabled or self.os.sound_volume <= 0:
            return
        try:
            self.root.bell()
        except tk.TclError:
            pass

    def show_desktop(self) -> None:
        if getattr(self, "_desktop_hidden", False):
            for win in list(self.windows):
                try:
                    win.deiconify()
                except tk.TclError:
                    pass
            self._desktop_hidden = False
            return
        self._desktop_hidden = True
        for win in list(self.windows):
            try:
                win.withdraw()
            except tk.TclError:
                pass

    def lock_screen(self) -> None:
        LockScreen(self.root, self.os)

    def _on_proc_killed(self, pid: int) -> None:
        if pid == 42:
            self.os.save_state()
            self.root.after(50, self.root.destroy)
            return
        for win in list(self.windows):
            if getattr(win, "pid", None) == pid:
                win.close()

    def launch_from_os(self, key: str, *args) -> bool:
        if key.startswith("pkg:"):
            package = key[4:]
            self.root.after(10, lambda: open_package_app(self, package))
            return package in self.os.packages.apps
        entry = APPS.get(key)
        if not entry:
            return False
        if key == "edit" and args:
            args = ("/" + "/".join(self.os.vfs.resolve(args[0])),)
        self.root.after(10, lambda: entry[2](self, *args))
        return True

    def _schedule_layout(self, event=None) -> None:
        if self._relayout_job:
            self.root.after_cancel(self._relayout_job)
        self._relayout_job = self.root.after(60, self.place_icons)

    def place_icons(self) -> None:
        self._relayout_job = None
        H, W = self.canvas.winfo_height(), self.canvas.winfo_width()
        if H < 150 or (W, H) == self._last_layout_size:
            return
        self._last_layout_size = (W, H)
        for ic in self.icons:
            ic.frame.destroy()
        self.icons.clear()
        self.canvas.delete("all")
        x, y = 30, 30
        for key, (title, icon, opener) in APPS.items():
            if key in self.os.icon_positions:
                px, py = self._clamp_icon(*self.os.icon_positions[key], W, H)
            else:
                px, py = float(x), float(y)
            self.icons.append(DesktopIcon(self.canvas, title, icon,
                                          lambda o=opener: o(self), px, py,
                                          lambda xx, yy, k=key: self._save_icon(k, xx, yy),
                                          self.os.icon_size, self.os.icon_scale))
            y += 110
            if y + 96 > H - 30:
                y = 30
                x += 110
        self.canvas.create_text(W - 20, H - 14, anchor="se", fill="#5b6f88",
                                font=FONT,
                                text="Super — Пуск  •  Ctrl+Alt+L — Lock  •  F11 — fullscreen")

    @staticmethod
    def _clamp_icon(x, y, W, H):
        size = 96
        grid = size + 14
        usable_h = max(0, H - TASKBAR_H)
        x = round(max(0, min(float(x), max(0, W - size))) / grid) * grid
        y = round(max(0, min(float(y), max(0, usable_h - size))) / grid) * grid
        return (max(0, min(x, max(0, W - size))),
                max(0, min(y, max(0, usable_h - size))))

    def _save_icon(self, key, x, y):
        W, H = self.canvas.winfo_width(), self.canvas.winfo_height()
        x, y = self._clamp_icon(x, y, W, H)
        self.os.icon_positions[key] = [int(x), int(y)]
        self.os.save_state()

    def context_menu(self, event=None):
        menu = tk.Menu(self.root, tearoff=False)
        menu.add_command(label="Открыть терминал",
                         command=lambda: open_terminal(self))
        menu.add_command(label="Настройки",
                         command=lambda: open_settings(self))
        menu.add_command(label="Сменить обои", command=self._next_wallpaper)
        menu.add_separator()
        menu.add_command(label="Заблокировать", command=self.lock_screen)
        menu.add_command(label="Выключить", command=self.shutdown)
        menu.tk_popup(event.x_root, event.y_root)

    def _apply_wallpaper(self) -> None:
        color = WALLPAPERS.get(self.os.wallpaper, WALLPAPERS["nebula"])
        self.root.configure(bg=color)
        self.canvas.configure(bg=color)

    def _next_wallpaper(self):
        names = list(WALLPAPERS)
        idx = names.index(self.os.wallpaper) if self.os.wallpaper in names else 0
        self.os.wallpaper = names[(idx + 1) % len(names)]
        self._apply_wallpaper()
        self.os.save_state()

    @staticmethod
    def _tint(btn, bg: str, fg: str) -> None:
        try:
            btn.config(bg=bg, fg=fg)
        except tk.TclError:
            pass

    def register_window(self, win) -> None:
        self.windows.append(win)
        btn = tk.Button(self.task_frame, text=f"  {win.title()}  ", bg=TASK_IDLE,
                        fg=FG_TASKBAR, bd=0, font=FONT, activebackground=ACCENT,
                        activeforeground="white",
                        command=lambda w=win: self.focus_window(w))
        btn.pack(side="left", padx=3, pady=6, fill="y")
        self.taskbar_buttons[win] = btn
        win.bind("<Unmap>", lambda e: self._tint(btn, TASK_MIN, FG_TASKBAR))
        win.bind("<Map>", lambda e: self._tint(btn, TASK_IDLE, FG_TASKBAR))
        win.bind("<FocusIn>", lambda e: self._tint(btn, ACCENT, "white"))
        win.bind("<FocusOut>", lambda e: self._tint(btn, TASK_IDLE, FG_TASKBAR))
        self._tint(btn, ACCENT, "white")

    def unregister_window(self, win) -> None:
        if win in self.windows:
            self.windows.remove(win)
        btn = self.taskbar_buttons.pop(win, None)
        if btn:
            btn.destroy()

    def focus_window(self, win) -> None:
        try:
            if str(win.state()) == "withdrawn":
                win.deiconify()
            else:
                win.withdraw()
                self._desktop_hidden = False
                return
            win.lift()
            win.focus_force()
        except tk.TclError:
            pass

    def close_start_menu(self) -> None:
        if self.start_menu is not None:
            try:
                self.start_menu.destroy()
            except tk.TclError:
                pass
            self.start_menu = None

    def toggle_start_menu(self, query="") -> None:
        if self.start_menu is not None:
            if query and hasattr(self, "start_search_var"):
                self.start_search_var.set(query)
            elif not query:
                self.close_start_menu()
