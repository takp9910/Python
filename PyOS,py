    def cmd_tictactoe(self, args) -> None:
        if self.k.launcher and self.k.launcher("tictactoe"):
            return
        self._print("Крестики-нолики: X — вы, O — компьютер")
        board = [" "] * 9
        lines = [(0, 1, 2), (3, 4, 5), (6, 7, 8), (0, 3, 6),
                 (1, 4, 7), (2, 5, 8), (0, 4, 8), (2, 4, 6)]

        def render():
            return "\n".join(" | ".join(board[r * 3:r * 3 + 3]) for r in range(3))

        def winner():
            for a, b, c in lines:
                if board[a] != " " and board[a] == board[b] == board[c]:
                    return board[a]
            return None

        while " " in board and not winner():
            self._print(render())
            try:
                raw = input("клетка 1-9> ").strip()
            except (EOFError, KeyboardInterrupt):
                return
            if not raw.isdigit() or not 1 <= int(raw) <= 9 or board[int(raw) - 1] != " ":
                continue
            board[int(raw) - 1] = "X"
            if " " in board and not winner():
                free = [i for i, v in enumerate(board) if v == " "]
                board[random.choice(free)] = "O"
        self._print(render())
        w = winner()
        self._print("Победа!" if w == "X" else "Победа компьютера" if w == "O" else "Ничья")

    def cmd_hangman(self, args) -> None:
        if self.k.launcher and self.k.launcher("hangman"):
            return
        words = ["питон", "компьютер", "терминал", "память", "ядро"]
        word = random.choice(words)
        guessed: set[str] = set()
        wrong: set[str] = set()
        while True:
            masked = " ".join(c if c in guessed else "_" for c in word)
            self._print(f"{masked}  ошибки: {' '.join(sorted(wrong)) or '-'}")
            if all(c in guessed for c in word):
                self.ok("Победа!")
                return
            if len(wrong) >= 6:
                self.err(f"Проигрыш. Слово: {word}")
                return
            try:
                ch = input("буква> ").strip().lower()
            except (EOFError, KeyboardInterrupt):
                return
            if len(ch) != 1 or ch in guessed or ch in wrong:
                continue
            (guessed if ch in word else wrong).add(ch)

