def open_market(desktop, *_) -> None:
    w = AppWindow(desktop, "Магазин", "🛍", mem=8)
    kernel = desktop.os
    lb = tk.Listbox(w.body, font=("Consolas", 11), bd=0)
    lb.pack(fill="both", expand=True)

    def refresh():
        lb.delete(0, "end")
        for n, d in kernel.packages.catalog().items():
            mark = "✓" if n in kernel.packages.installed else " "
            version = f" v{d.get('version')}" if d.get("version") else ""
            lb.insert("end", f"[{mark}] {n:<12}{version} {d['desc']}")

    def get_name():
        sel = lb.curselection()
        if not sel:
            return None
        line = lb.get(sel[0])
        return line.split("]")[1].strip().split()[0]

    def install():
        name = get_name()
        if not name:
            return
        try:
            kernel.packages.install(name)
        except PyOSError as e:
            messagebox.showerror("Магазин", str(e), parent=w)
        refresh()

    def remove():
        name = get_name()
        if not name:
            return
        try:
            kernel.packages.remove(name)
        except PyOSError as e:
            messagebox.showerror("Магазин", str(e), parent=w)
        refresh()

    def update_repo():
        url = simpledialog.askstring("Репозиторий", "URL JSON-индекса HTTPS:",
                                     initialvalue=kernel.packages.repo_url, parent=w)
        if not url:
            return
        try:
            count = kernel.packages.update(url)
            kernel.save_state()
            messagebox.showinfo("Магазин", f"Загружено пакетов: {count}", parent=w)
            refresh()
        except PyOSError as e:
            messagebox.showerror("Магазин", str(e), parent=w)

    def launch_app():
        name = get_name()
        if name and name in kernel.packages.apps:
            desktop.launch_from_os("pkg:" + name)
        elif name:
            messagebox.showinfo("Магазин", "У этого пакета нет GUI-приложения", parent=w)

    bar = tk.Frame(w.body, bg=BG_WINDOW)
    bar.pack(fill="x", pady=(8, 0))
    tk.Button(bar, text="📥 Установить", command=install).pack(side="left")
    tk.Button(bar, text="🗑 Удалить", command=remove).pack(side="left", padx=6)
    tk.Button(bar, text="🌐 Обновить каталог", command=update_repo).pack(side="left")
    tk.Button(bar, text="▶ Запустить", command=launch_app).pack(side="left", padx=6)
    refresh()


