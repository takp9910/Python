def open_processes(desktop, *_) -> None:
    w = AppWindow(desktop, "Процессы", "📊", mem=9)
    kernel = desktop.os
    lb = tk.Listbox(w.body, font=("Consolas", 11), bd=0)
    lb.pack(fill="both", expand=True)

    def refresh():
        lb.delete(0, "end")
        lb.insert("end", f"{'PID':>5} {'USER':<8} {'NICE':>4} {'MEM':>5} STATE    NAME")
        for p in kernel.procs.procs:
            lb.insert("end", f"{p.pid:>5} {p.user:<8} {p.nice:>4} {p.mem:>4}M "
                             f"{p.state:<8} {p.name}")

