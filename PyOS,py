class ScheduledJob:
    def __init__(self, jid: int, kind: str, spec: str, command: str) -> None:
        self.id = jid
        self.kind = kind
        self.spec = spec
        self.command = command
        self.timer: Optional[threading.Timer] = None
        self.last_run: Optional[float] = None
        self.runs = 0


class Scheduler:
    """Планировщик задач: cron, at, bg."""

    def __init__(self, kernel: "Kernel") -> None:
        self.kernel = kernel
        self.jobs: dict[int, ScheduledJob] = {}
        self._next = 1
        self._lock = threading.Lock()
        self._stop = False
        self._cron_timer: Optional[threading.Timer] = None

    @staticmethod
    def _cron_match(field: str, value: int) -> bool:
        if field == "*":
            return True
        for part in field.split(","):
            if part.startswith("*/"):
                try:
                    step = int(part[2:])
                except ValueError:
                    continue
                if step > 0 and value % step == 0:
                    return True
            elif "-" in part:
                a, b = part.split("-", 1)
                try:
                    if int(a) <= value <= int(b):
                        return True
                except ValueError:
                    continue
            elif part.isdigit() and int(part) == value:
                return True
        return False

    def _cron_tick(self) -> None:
        if self._stop:
            return
        now = datetime.datetime.now()
        with self._lock:
            jobs = list(self.jobs.values())
        for j in jobs:
            if j.kind != "cron":
                continue
            try:
                m, h, d, mo, wd = j.spec.split()
            except ValueError:
                continue
            matched = (
                self._cron_match(m, now.minute)
                and self._cron_match(h, now.hour)
                and self._cron_match(d, now.day)
                and self._cron_match(mo, now.month)
                and (wd == "*" or self._cron_match(wd, now.weekday() + 1))
            )
            if matched and (j.last_run is None or time.time() - j.last_run > 55):
                j.last_run = time.time()
                j.runs += 1
                threading.Thread(target=self._run_job, args=(j,), daemon=True).start()
        if self._stop:
            return
        t = threading.Timer(20, self._cron_tick)
        t.daemon = True
        self._cron_timer = t
        t.start()

    def _run_job(self, job: ScheduledJob) -> None:
        try:
            self.kernel.shell.execute_silent(job.command)
        except Exception as e:
            self.kernel.logger.error(f"job {job.id}: {e}")

    def start(self) -> None:
        self._cron_tick()

    def stop(self) -> None:
        self._stop = True
        if self._cron_timer:
            self._cron_timer.cancel()
        with self._lock:
            for j in self.jobs.values():
                if j.timer:
                    j.timer.cancel()

    def add_cron(self, spec: str, command: str) -> int:
        if len(spec.split()) != 5:
            raise PyOSError("cron: нужно 5 полей 'M H D Mo W'")
        jid = self._next
        self._next += 1
        job = ScheduledJob(jid, "cron", spec, command)
        self.jobs[jid] = job
        return jid

    def add_at(self, at_spec: str, command: str) -> int:
        delay = None
        if at_spec.startswith("+"):
            try:
                delay = int(at_spec[1:])
            except ValueError:
                raise PyOSError("at: '+сек' требует число") from None
        else:
            try:
                hh, mm = at_spec.split(":")
                now = datetime.datetime.now()
                target = now.replace(hour=int(hh), minute=int(mm), second=0, microsecond=0)
                if target <= now:
                    target += datetime.timedelta(days=1)
                delay = (target - now).total_seconds()
            except Exception:
                raise PyOSError("at: ожидаю HH:MM или +секунды") from None
        jid = self._next
        self._next += 1
        job = ScheduledJob(jid, "at", at_spec, command)
        t = threading.Timer(delay, self._run_job, args=(job,))
        t.daemon = True
        job.timer = t
        self.jobs[jid] = job
        t.start()
        return jid

    def add_bg(self, command: str) -> int:
        jid = self._next
        self._next += 1
        job = ScheduledJob(jid, "bg", "now", command)
        self.jobs[jid] = job

        def run():
            job.last_run = time.time()
            job.runs += 1
            self._run_job(job)

        threading.Thread(target=run, daemon=True).start()
        return jid

    def remove(self, jid: int) -> bool:
        j = self.jobs.pop(jid, None)
        if j and j.timer:
            j.timer.cancel()
        return j is not None

    def list_jobs(self) -> list[ScheduledJob]:
        return sorted(self.jobs.values(), key=lambda j: j.id)


