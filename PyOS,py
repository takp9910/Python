class PackageManager:
    """Виртуальный менеджер пакетов: установка регистрирует команды."""

    REGISTRY: dict[str, dict] = {
        "hello": {"desc": "Команда hello", "size": 4, "provides": ["hello"]},
        "sysmon": {"desc": "Мини-монитор системы", "size": 12, "provides": ["sysmon"]},
        "calc-plus": {"desc": "Расширенный калькулятор", "size": 8, "provides": ["calcplus"]},
        "fortune": {"desc": "Случайные цитаты", "size": 3, "provides": ["fortune"]},
        "figlet": {"desc": "ASCII-арт из текста", "size": 6, "provides": ["figlet"]},
    }

    def __init__(self, kernel: "Kernel") -> None:
        self.kernel = kernel
        self.installed: set[str] = set()
        self.repo_url = ""
        self.remote_registry: dict[str, dict] = {}
        self.commands: dict[str, dict] = {}
        self.apps: dict[str, dict] = {}

    def export_extensions(self) -> dict:
        return {"commands": self.commands, "apps": self.apps}

    def import_extensions(self, data: Any) -> None:
        if not isinstance(data, dict):
            return
        commands = data.get("commands", {})
        apps = data.get("apps", {})
        if isinstance(commands, dict):
            self.commands = commands
        if isinstance(apps, dict):
            self.apps = apps

    @staticmethod
    def _valid_name(name: str) -> bool:
        return bool(re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,63}", name))

    def catalog(self) -> dict[str, dict]:
        catalog = dict(self.REGISTRY)
        catalog.update(self.remote_registry)
        return catalog

    def set_repo(self, url: str) -> None:
        url = url.strip()
        if not re.match(r"https://", url) and not re.match(r"http://localhost(?::\d+)?/", url):
            raise PyOSError("репозиторий должен использовать HTTPS (или localhost для тестов)")
        self.repo_url = url

    def update(self, url: Optional[str] = None) -> int:
        target = (url or self.repo_url).strip()
        if not target:
            raise PyOSError("репозиторий не задан: pkg repo <https-url>")
        self.set_repo(target)
        try:
            with urllib.request.urlopen(target, timeout=8) as response:
                raw = response.read(2 * 1024 * 1024 + 1)
        except (OSError, urllib.error.URLError) as e:
            raise PyOSError(f"не удалось обновить репозиторий: {e}") from None
        if len(raw) > 2 * 1024 * 1024:
            raise PyOSError("индекс репозитория слишком большой")
        try:
            data = json.loads(raw.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError):
            raise PyOSError("репозиторий вернул некорректный JSON") from None
        packages = data.get("packages") if isinstance(data, dict) else None
        if not isinstance(packages, dict):
            raise PyOSError("индекс должен содержать объект packages")
        checked = {}
        for name, info in packages.items():
            if not self._valid_name(str(name)) or not isinstance(info, dict):
                continue
            desc = str(info.get("desc", "Без описания"))[:300]
            version = str(info.get("version", "0.0.0"))[:32]
            files = info.get("files", {})
            if not isinstance(files, dict):
                files = {}
            safe_files = {}
            for path, content in files.items():
                path = str(path)
                if (not path or path.startswith("/") or ".." in path.split("/")
                        or len(path) > 160 or not isinstance(content, str)):
                    continue
                safe_files[path] = content[:512 * 1024]
            checked[str(name)] = {"desc": desc, "version": version,
                                  "size": int(info.get("size", 0) or 0),
                                  "provides": list(info.get("provides", []))[:32],
                                  "files": safe_files}
        self.remote_registry = checked
        return len(checked)

    def list_installed(self) -> list[str]:
        return sorted(self.installed)

    def search(self, query: str) -> list[tuple[str, str]]:
        q = query.lower()
        return [(n, d["desc"]) for n, d in self.catalog().items()
                if q in n or q in d["desc"].lower()]

    def install(self, name: str) -> None:
        if not self.kernel.users.is_admin():
            raise PermError("для установки пакетов нужен root")
        catalog = self.catalog()
        if name not in catalog:
            raise PyOSError(f"пакет не найден: {name}")
        if name in self.installed:
            raise PyOSError(f"уже установлен: {name}")
        self.kernel.vfs.mkdir_p(f"/usr/pkg/{name}")
        info = catalog[name]
        files = info.get("files", {}) if isinstance(info, dict) else {}
        if not files:
            files = {"README": info["desc"] + "\n"}
        manifest = {}
        if "manifest.json" in files:
            try:
                manifest = json.loads(files["manifest.json"])
            except (TypeError, json.JSONDecodeError):
                raise PyOSError("manifest.json имеет некорректный JSON") from None
            if not isinstance(manifest, dict) or manifest.get("name", name) != name:
                raise PyOSError("manifest.json: неверное имя пакета")
        new_commands = {}
        raw_commands = manifest.get("commands", {})
        if not isinstance(raw_commands, dict) or len(raw_commands) > 32:
            raise PyOSError("manifest.json: неверный список commands")
        for command, spec in raw_commands.items():
            if not self._valid_name(str(command)) or not isinstance(spec, dict):
                raise PyOSError("manifest.json: неверная команда")
            output = str(spec.get("output", ""))
            if len(output) > 20000:
                raise PyOSError("manifest.json: вывод команды слишком большой")
            new_commands[str(command)] = {"package": name,
                                          "description": str(spec.get("description", ""))[:200],
                                          "output": output}
        app = manifest.get("app")
        if app is not None:
            if not isinstance(app, dict):
                raise PyOSError("manifest.json: неверное описание app")
            app = {"package": name, "title": str(app.get("title", name))[:80],
                   "icon": str(app.get("icon", "📦"))[:8],
                   "content": str(app.get("content", info.get("desc", "")))[:20000]}
        for path, content in files.items():
            parent_parts = path.split("/")[:-1]
            if parent_parts:
                self.kernel.vfs.mkdir_p("/usr/pkg/" + name + "/" + "/".join(parent_parts))
            self.kernel.vfs.write(f"/usr/pkg/{name}/{path}", content, system=True)
        self.installed.add(name)
        self.commands.update(new_commands)
        if app is not None:
            self.apps[name] = app
        self.kernel.bus.emit("pkg_installed", name=name)

    def remove(self, name: str) -> None:
        if not self.kernel.users.is_admin():
            raise PermError("для удаления пакетов нужен root")
        if name not in self.installed:
            raise PyOSError(f"не установлен: {name}")
        self.installed.discard(name)
        self.commands = {k: v for k, v in self.commands.items()
                         if v.get("package") != name}
        self.apps.pop(name, None)
        try:
            self.kernel.vfs.rm(f"/usr/pkg/{name}", recursive=True, trash=False)
        except VFSError:
            pass


