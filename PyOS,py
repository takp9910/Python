def run_gui() -> bool:
    if tk is None:
        print("tkinter не установлен — запускаю CLI.")
        return False
    try:
        root = tk.Tk()
    except tk.TclError as e:
        print(f"Нет графического дисплея ({e}) — запускаю CLI.")
        return False
    kernel = Kernel()
    kernel.start_autosave()

    def open_desktop() -> None:
        root.deiconify()
        Desktop(root, kernel)
        if kernel.desktop_notify:
            kernel.desktop_notify("PyOS",
                                  f"Добро пожаловать, {kernel.users.whoami()}!")

    def after_boot() -> None:
        if "--nologin" in sys.argv:
            open_desktop()
        else:
            LoginScreen(root, kernel, open_desktop)

    if "--noboot" in sys.argv:
        if "--nologin" in sys.argv:
            Desktop(root, kernel)
        else:
            root.withdraw()
            LoginScreen(root, kernel, open_desktop)
    else:
        root.withdraw()
        BootScreen(root, after_boot)

    if "--webserver" in sys.argv:
        _start_webserver(kernel)

    root.mainloop()
    kernel.shutdown()
    return True


def _start_webserver(kernel: Kernel) -> None:
    """Реальный HTTP-сервер на 127.0.0.1:8080, отдающий /public из VFS."""
    class Handler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            path = "/public" + (self.path if self.path != "/" else "/index.html")
            try:
                content = kernel.vfs.read(path).encode("utf-8")
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.end_headers()
                self.wfile.write(content)
            except VFSError:
                self.send_error(404)

        def log_message(self, *args):
            pass

    def serve():
        try:
            srv = http.server.HTTPServer(("127.0.0.1", 8080), Handler)
            srv.serve_forever()
        except OSError:
            pass

    t = threading.Thread(target=serve, daemon=True)
    t.start()


def main() -> None:
    if "--cli" in sys.argv or not run_gui():
        kernel = Kernel()
        kernel.start_autosave()
        try:
            kernel.shell.repl()
        finally:
            kernel.shutdown()


if __name__ == "__main__":
    main()
