class Logger:
    """Логирование в /var/log/pyos.log и в stderr при DEBUG."""

    LEVELS = {"DEBUG": 10, "INFO": 20, "WARNING": 30, "ERROR": 40}

    def __init__(self, vfs: "VFS", path: str = "/var/log/pyos.log") -> None:
        self.vfs = vfs
        self.path = path
        self.level = "INFO"
        self._lock = threading.Lock()
        self._ensure_file()

    def _ensure_file(self) -> None:
        try:
            if not self.vfs.exists(self.path):
                self.vfs.mkdir_p("/var/log")
                self.vfs.write(self.path, "", system=True)
        except Exception:
            pass

    def log(self, level: str, msg: str) -> None:
        if self.LEVELS.get(level, 0) < self.LEVELS.get(self.level, 20):
            return
        line = f"{now_iso()} [{level}] {msg}\n"
        with self._lock:
            try:
                cur = self.vfs.read(self.path) if self.vfs.exists(self.path) else ""
                self.vfs.write(self.path, cur + line, system=True)
            except Exception:
                pass
        if self.level == "DEBUG":
            sys.stderr.write(line)

    def debug(self, msg: str) -> None: self.log("DEBUG", msg)
    def info(self, msg: str) -> None: self.log("INFO", msg)
    def warning(self, msg: str) -> None: self.log("WARNING", msg)
    def error(self, msg: str) -> None: self.log("ERROR", msg)


