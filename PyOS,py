    def cmd_kill(self, args) -> None:
        sig = "TERM"
        args = list(args)
        if "-9" in args:
            sig = "KILL"
            args.remove("-9")
        elif "-STOP" in args:
            sig = "STOP"
            args.remove("-STOP")
        elif "-CONT" in args:
            sig = "CONT"
            args.remove("-CONT")
        if not args:
            self.err("укажите PID")
            return
        try:
            pid = int(args[0])
        except ValueError:
            self.err("PID должен быть числом")
            return
        if not self.k.users.is_admin():
            p = self.k.procs.find(pid)
            if p and p.user != self.k.users.current:
                self.err("нет прав")
                return
        ok, msg = self.k.procs.kill(pid, sig)
        (self.ok if ok else self.err)(msg)

