            return
        node = self.k.vfs._get(self.k.vfs.resolve(args[1]))
        if node is None:
            self.err("нет такого файла")
            return
        if not self.k.users.is_admin():
            self.err("нужен root")
            return
        node.owner = args[0]
        self.ok("владелец изменён")

    def cmd_ln(self, args) -> None:
        if args and args[0] == "-s":
            args = args[1:]
        if len(args) != 2:
            self.err("использование: ln [-s] <target> <link>")
            return
        target, link = args
        try:
            parent, name = self.k.vfs._split(link)
            if not self.k.vfs._check_perm(parent, "w"):
                raise PermError(f"нет прав: {link}")
            parent.children[name] = FileNode(kind="link", link_target=target)
            self.ok("ссылка создана")
        except (VFSError, PermError) as e:
            self.err(str(e))

