def open_browser(desktop, *_) -> None:
    w = AppWindow(desktop, "Браузер", "🌐", mem=8)
    toolbar = tk.Frame(w.body, bg=BG_WINDOW)
    toolbar.pack(fill="x")
    tabs = ttk.Notebook(w.body)
    tabs.pack(fill="both", expand=True, pady=(4, 0))
    tab_states: dict[str, dict] = {}
    bookmarks: list[str] = []

    def normalize(value: str) -> str:
        value = value.strip()
        if not value:
            return "http://localhost/"
        return value if re.match(r"https?://", value) else "http://" + value

    def state_for_tab() -> Optional[dict]:
        tab_id = tabs.select()
        return tab_states.get(tab_id)

    def update_nav(state: dict) -> None:
        if not state:
            return
        state["back"].config(state="normal" if state["back_history"] else "disabled")
        state["forward"].config(state="normal" if state["forward_history"] else "disabled")

    def mark_urls(state: dict) -> None:
        text = state["text"]
        text.tag_delete("url")
        content = text.get("1.0", "end-1c")
        for match in re.finditer(r"(?:https?://|localhost(?:/|$))[\w.\-/:?=&%#]+", content):
            start = f"1.0+{match.start()}c"
            end = f"1.0+{match.end()}c"
            text.tag_add("url", start, end)
        text.tag_configure("url", foreground="#2563eb", underline=True)
        text.tag_bind("url", "<Button-1>",
                      lambda event, s=state: open_tag_url(s, event))

    def open_tag_url(state: dict, event) -> None:
        index = state["text"].index(f"@{event.x},{event.y}")
        value = state["text"].get(
            state["text"].tag_prevrange("url", index)[0] if state["text"].tag_prevrange("url", index)
            else index,
            state["text"].tag_nextrange("url", index)[1]
            if state["text"].tag_nextrange("url", index) else index)
        if value:
            load(state, value.strip(), True)

    def load(state: dict, value: str, add_history: bool = True) -> None:
        u = normalize(value)
        if add_history and state["current"] and state["current"] != u:
            state["back_history"].append(state["current"])
            state["forward_history"].clear()
        state["current"] = u
        state["url"].delete(0, "end")
        state["url"].insert(0, u)
        try:
            host_path = u.split("//", 1)[1]
            path = "/" + host_path.split("/", 1)[1] if "/" in host_path else "/"
            response = desktop.os.net.fetch(u)
            if path == "/":
                response += "\n\n" + desktop.os.vfs.read("/public/index.html")
            state["text"].delete("1.0", "end")
            state["text"].insert("1.0", response)
            state["status"].config(text=f"Открыто: {u}")
            mark_urls(state)
        except (PyOSError, VFSError) as e:
            state["text"].delete("1.0", "end")
            state["text"].insert("1.0", f"Ошибка: {e}")
            state["status"].config(text=f"Ошибка: {e}")
        update_nav(state)

    def go() -> None:
        state = state_for_tab()
        if state:
            load(state, state["url"].get())

    def back() -> None:
        state = state_for_tab()
        if state and state["back_history"]:
            previous = state["back_history"].pop()
            state["forward_history"].append(state["current"])
            load(state, previous, False)

    def forward() -> None:
        state = state_for_tab()
        if state and state["forward_history"]:
            following = state["forward_history"].pop()
            state["back_history"].append(state["current"])
            load(state, following, False)

    def reload() -> None:
        state = state_for_tab()
        if state:
            load(state, state["current"] or state["url"].get(), False)

    def find_page() -> None:
        state = state_for_tab()
        if not state:
            return
        query = simpledialog.askstring("Поиск", "Найти на странице:", parent=w)
        if not query:
            return
        state["text"].tag_remove("find", "1.0", "end")
        pos = "1.0"
        count = 0
        while True:
            pos = state["text"].search(query, pos, "end", nocase=True)
            if not pos:
                break
            end = f"{pos}+{len(query)}c"
            state["text"].tag_add("find", pos, end)
            pos = end
            count += 1
        state["text"].tag_configure("find", background="#fde68a", foreground="black")
        state["status"].config(text=f"Найдено совпадений: {count}")

    def bookmark() -> None:
        state = state_for_tab()
        if state and state["current"] and state["current"] not in bookmarks:
            bookmarks.append(state["current"])
            state["status"].config(text="Добавлено в закладки")

    def show_bookmarks() -> None:
        if not bookmarks:
            messagebox.showinfo("Закладки", "Закладок пока нет", parent=w)
            return
        choice = simpledialog.askstring("Закладки", "\n".join(
            f"{i + 1}. {u}" for i, u in enumerate(bookmarks)), parent=w)
        if choice and choice.isdigit() and 1 <= int(choice) <= len(bookmarks):
            state = state_for_tab()
            if state:
                load(state, bookmarks[int(choice) - 1])

    def new_tab() -> None:
        frame = tk.Frame(tabs, bg=BG_WINDOW)
        nav = tk.Frame(frame, bg=BG_WINDOW)
        nav.pack(fill="x")
        back_btn = tk.Button(nav, text="←", width=3, command=back, state="disabled")
        back_btn.pack(side="left", padx=2)
        forward_btn = tk.Button(nav, text="→", width=3, command=forward, state="disabled")
        forward_btn.pack(side="left", padx=2)
        url = tk.Entry(nav, font=FONT)
        url.pack(side="left", fill="x", expand=True)
        url.insert(0, "http://localhost/")
        text = tk.Text(frame, font=("Consolas", 11), bd=0)
        text.pack(fill="both", expand=True, pady=6)
        status = tk.Label(frame, text="Готово", bg=BG_WINDOW, anchor="w")
        status.pack(side="bottom", fill="x")
        state = {"url": url, "text": text, "status": status, "back": back_btn,
                 "forward": forward_btn, "back_history": [], "forward_history": [],
                 "current": ""}
        tab_id = str(frame)
        tab_states[tab_id] = state
        tabs.add(frame, text="Новая вкладка")
        tabs.select(frame)
        url.bind("<Return>", lambda e: go())
        load(state, url.get(), False)

    tk.Button(toolbar, text="＋ Вкладка", command=new_tab).pack(side="left", padx=2)
    tk.Button(toolbar, text="Открыть", command=go).pack(side="left", padx=2)
    tk.Button(toolbar, text="⟳", command=reload).pack(side="left", padx=2)
    tk.Button(toolbar, text="⌕ Поиск", command=find_page).pack(side="left", padx=2)
    tk.Button(toolbar, text="☆ Закладка", command=bookmark).pack(side="left", padx=2)
    tk.Button(toolbar, text="Закладки", command=show_bookmarks).pack(side="left", padx=2)
    tabs.bind("<<NotebookTabChanged>>", lambda e: update_nav(state_for_tab() or {}))
    new_tab()


